---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';
import { formatDate } from '../utils/format';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: readonly string[];
  headings?: readonly { depth: number; slug: string; text: string }[];
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
}

const { title, description, pubDate, updatedDate, category, tags, headings = [], prev, next } =
  Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// 目录只收 h2 / h3，且条目太少时不出（一两个标题的目录没有意义）
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'zh-CN',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Person', name: site.author },
  publisher: { '@id': `${site.url}/#organization` },
  articleSection: category,
  keywords: tags.join(', '),
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="mx-auto max-w-2xl px-4 py-12">
    <a href="/blog/" class="text-sm text-muted transition-colors hover:text-primary">← 返回博客</a>

    <header class="mt-6 border-b border-line pb-6">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted">
        <span class="badge badge-primary">{category}</span>
        <time datetime={formatDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>更新于 {formatDate(updatedDate)}</span>
          )
        }
      </div>
      <h1 class="text-[clamp(28px,3.6vw,40px)] font-extrabold leading-[1.16] tracking-[-0.03em] text-strong">
        {title}
      </h1>
      <p class="mt-4 text-base leading-[1.85] tracking-[0.02em] text-muted">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="badge">#{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      toc.length > 2 && (
        <nav class="card mt-8 p-5" aria-label="文章目录">
          <p class="label-cjk mb-3 text-[12px] text-muted">目录</p>
          <ul class="space-y-2 text-sm">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a
                  href={`#${heading.slug}`}
                  class="text-muted transition-colors hover:text-primary"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose-nwn mt-8">
      <slot />
    </div>

    <footer class="mt-12 border-t border-line pt-6 text-sm text-muted">
      <p>
        本文由 {site.author} 发布，转载请注明出处。
        <a href="/rss.xml" class="text-primary hover:opacity-80">RSS 订阅</a>
      </p>
    </footer>

    <nav class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="文章导航">
      {
        prev ? (
          <a href={prev.href} class="card flex flex-col p-4">
            <span class="text-xs text-muted">← 上一篇</span>
            <span class="mt-1 text-sm font-medium text-ink">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={next.href} class="card flex flex-col p-4 sm:text-right">
            <span class="text-xs text-muted">下一篇 →</span>
            <span class="mt-1 text-sm font-medium text-ink">{next.title}</span>
          </a>
        ) : null
      }
    </nav>
  </article>
</BaseLayout>
