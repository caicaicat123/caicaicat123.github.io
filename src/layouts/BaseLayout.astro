---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 404 这类页面不进索引 */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noindex = false,
} = Astro.props;

/**
 * 标题统一格式：`新世界网络|New World Network - 页面名`
 * 首页不带后缀，直接用品牌全称（首个词就是品牌，最利于摘要与站点识别）。
 * 说明：这里刻意不做「页面名在前」的写法 —— 品牌置前是全站统一的识别口径。
 */
const brand = `${site.name}|${site.nameEn}`;
const fullTitle = title === site.name ? brand : `${brand} - ${title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og-default.png', Astro.site ?? site.url).href;
const ogImageAlt = `${site.name} · ${site.nameEn}`;
// 品牌写法统一（结构化数据 / OG 图 / 标题同源）
const brandText = `${site.name}（${site.nameEn}）`;
// 背景网格只留在首屏：其它页面靠留白和晕染就够了，网格是偏「科技看板」的语汇
const isHome = Astro.url.pathname === '/';
// 面包屑：给生成式搜索与搜索引擎一个「这页在站点里的位置」的确定性信号。
// 中间层级用固定名称表（目前只有 /blog、/plugins 这类两级路径）。
const SECTION_NAMES: Record<string, string> = {
  blog: '博客',
  plugins: 'MC插件',
  minecraft: 'Minecraft',
  mod: '钢铁雄心4',
  about: '关于',
  contact: '联系',
  roadmap: '路线图',
  privacy: '隐私政策',
};
const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb =
  segments.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '首页', item: `${site.url}/` },
          ...segments.map((segment, index) => {
            const isLast = index === segments.length - 1;
            return {
              '@type': 'ListItem',
              position: index + 2,
              name: isLast ? title : (SECTION_NAMES[segment] ?? segment),
              item: `${site.url}/${segments.slice(0, index + 1).join('/')}/`,
            };
          }),
        ],
      }
    : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F7F4ED" />

    <script is:inline>
      // 在首屏渲染前定好主题，避免深浅色闪一下。
      // 默认宣纸（浅色）是明确的设计基准：只有用户手动切过才沿用记忆值，
      // 刻意不读系统偏好 —— 第一次来的访客看到的一定是宣纸。
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('nwn-theme');
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          }
        } catch (e) {
          /* localStorage 不可用时按默认宣纸（浅色） */
        }
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f4ed' : '#14120f');
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} · 博客`} href="/rss.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${site.url}/#organization`,
            name: site.name,
            alternateName: [site.nameEn, site.shortName],
            description: site.description,
            url: site.url,
            logo: ogImage,
            email: site.email,
            sameAs: [site.github],
          },
          {
            '@type': 'WebSite',
            '@id': `${site.url}/#website`,
            name: brandText,
            alternateName: `${site.name}|${site.nameEn}`,
            url: site.url,
            description: site.description,
            inLanguage: 'zh-CN',
            publisher: { '@id': `${site.url}/#organization` },
          },
          ...(breadcrumb ? [breadcrumb] : []),
        ],
      })}
    />
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- 背景层：两层水墨晕染（首屏另有 56px 网格） -->
    <div class="bg" aria-hidden="true">
      {isHome && <div class="bg-grid"></div>}
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-primary"
    >
      跳到正文
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
