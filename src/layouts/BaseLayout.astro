---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 404 这类页面不进索引 */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title === site.name ? `${site.name} · ${site.nameEn}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og-default.png', Astro.site ?? site.url).href;
const ogImageAlt = `${site.name} · ${site.nameEn}`;
// 背景网格只留在首屏：其它页面靠留白和晕染就够了，网格是偏「科技看板」的语汇
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F7F4ED" />

    <script is:inline>
      // 在首屏渲染前定好主题，避免深浅色闪一下。
      // 默认宣纸（浅色）是明确的设计基准：只有用户手动切过才沿用记忆值，
      // 刻意不读系统偏好 —— 第一次来的访客看到的一定是宣纸。
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('nwn-theme');
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          }
        } catch (e) {
          /* localStorage 不可用时按默认宣纸（浅色） */
        }
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f4ed' : '#14120f');
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} · 博客`} href="/rss.xml" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${site.url}/#organization`,
            name: site.name,
            alternateName: [site.nameEn, site.shortName],
            url: site.url,
            logo: ogImage,
            email: site.email,
            sameAs: [site.github],
          },
          {
            '@type': 'WebSite',
            '@id': `${site.url}/#website`,
            name: `${site.name} · ${site.nameEn}`,
            url: site.url,
            inLanguage: 'zh-CN',
            publisher: { '@id': `${site.url}/#organization` },
          },
        ],
      })}
    />
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- 背景层：两层水墨晕染（首屏另有 56px 网格） -->
    <div class="bg" aria-hidden="true">
      {isHome && <div class="bg-grid"></div>}
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-primary"
    >
      跳到正文
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // 光标柔光：只有精确指针 + 未开启「减少动效」时才启用。
      // 位置只写 transform（见 .bg-cursor），不碰 left/top —— 避免每帧触发布局。
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const bgLayer = document.querySelector('.bg');

      if (!reduceMotion && finePointer && bgLayer) {
        const orb = document.createElement('div');
        orb.className = 'bg-cursor';
        bgLayer.appendChild(orb);

        let x = window.innerWidth / 2;
        let y = window.innerHeight / 2;
        let cx = x;
        let cy = y;
        let raf = 0;

        const draw = () => {
          orb.style.setProperty('--cursor-x', `${cx}px`);
          orb.style.setProperty('--cursor-y', `${cy}px`);
        };

        const tick = () => {
          cx += (x - cx) * 0.08;
          cy += (y - cy) * 0.08;
          draw();
          raf = requestAnimationFrame(tick);
        };

        const stop = () => {
          if (raf) cancelAnimationFrame(raf);
          raf = 0;
        };

        draw();

        window.addEventListener(
          'mousemove',
          (event) => {
            x = event.clientX;
            y = event.clientY;
            if (!raf) raf = requestAnimationFrame(tick);
          },
          { passive: true },
        );

        // 指针离开页面就停下来，别让 rAF 空转
        document.addEventListener('mouseleave', () => {
          stop();
          orb.style.opacity = '0';
        });
        document.addEventListener('mouseenter', () => {
          orb.style.opacity = '0.3';
          if (!raf) raf = requestAnimationFrame(tick);
        });
      }
    </script>
  </body>
</html>
