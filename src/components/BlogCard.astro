---
interface Props {
  title: string;
  description: string;
  href: string;
  date: string;
  category: string;
  tags: readonly string[];
}

const { title, description, href, date, category, tags } = Astro.props;
---

<article class="card relative flex flex-col p-5">
  <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-muted">
    <span class="badge badge-primary">{category}</span>
    <time datetime={date}>{date}</time>
  </div>
  <h3 class="text-base font-semibold text-strong">
    <a
      href={href}
      class="transition-colors after:absolute after:inset-0 after:rounded-xl after:content-[''] hover:text-primary"
    >
      {title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{description}</p>
  {
    tags.length > 0 && (
      <div class="pointer-events-none mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="badge">#{tag}</span>
        ))}
      </div>
    )
  }
  <span class="pointer-events-none mt-4 inline-flex items-center gap-1 text-sm text-primary">
    阅读全文 <span aria-hidden="true">→</span>
  </span>
</article>
