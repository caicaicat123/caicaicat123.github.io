---
import { extraNav, nav, site } from '../data/site';

const year = new Date().getFullYear();
// 版权年份区间：起始年用工作室开始运营的年份（site.startedAt）
const yearRange = String(year) === site.startedAt ? site.startedAt : `${site.startedAt}–${year}`;
---

<footer class="mt-20 border-t border-line bg-surface/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <p class="text-sm font-semibold text-ink">{site.name}</p>
      <p class="mt-1 font-pixel text-[11px] text-muted">{site.nameEn}</p>
      <p class="mt-3 max-w-md text-base leading-relaxed text-muted">{site.vision}</p>
    </div>

    <div>
      <p class="mb-3 text-xs font-medium tracking-wider text-muted">导航</p>
      <ul class="space-y-2 text-sm">
        {
          nav.slice(0, 4).map((item) => (
            <li>
              <a href={item.href} class="text-muted transition-colors hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="mb-3 text-xs font-medium tracking-wider text-muted">相关</p>
      <ul class="space-y-2 text-sm">
        {
          [...nav.slice(4), ...extraNav].map((item) => (
            <li>
              <a href={item.href} class="text-muted transition-colors hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="text-muted transition-colors hover:text-primary">RSS 订阅</a>
        </li>
        <li>
          <a
            href={site.github}
            rel="noopener noreferrer"
            target="_blank"
            class="text-muted transition-colors hover:text-primary">GitHub</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Copyright © {yearRange} {site.nameEn}, All Rights Reserved.</p>
      <p class="font-pixel">{site.slogan}</p>
    </div>
  </div>
</footer>
