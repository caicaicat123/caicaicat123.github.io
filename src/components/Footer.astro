---
import Brand from './Brand.astro';
import { footerNav, site } from '../data/site';

const year = new Date().getFullYear();
const yearRange = String(year) === site.startedAt ? site.startedAt : `${site.startedAt}–${year}`;
---

<footer class="relative mt-24 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-3">
          <Brand />
        </div>
        <p class="mt-5 max-w-md text-sm leading-[1.85] text-muted">{site.vision}</p>
      </div>

      <div>
        <p class="label-cjk mb-4 text-[12px] text-muted">导航</p>
        <ul class="space-y-2.5 text-sm">
          {
            footerNav.main.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-cjk mb-4 text-[12px] text-muted">相关</p>
        <ul class="space-y-2.5 text-sm">
          {
            footerNav.related.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/rss.xml" class="text-muted transition-colors hover:text-ink">RSS 订阅</a>
          </li>
          <li>
            <a
              href={site.github}
              rel="noopener noreferrer"
              target="_blank"
              class="text-muted transition-colors hover:text-ink">GitHub</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Copyright © {yearRange} {site.nameEn}, All Rights Reserved.</p>
      <p class="font-serif text-[12px] tracking-[0.18em]">{site.slogan}</p>
    </div>
  </div>
</footer>
