---
import Brand from './Brand.astro';
import { footerNav, site } from '../data/site';
import { friends } from '../data/friends';

const year = new Date().getFullYear();
const yearRange = String(year) === site.startedAt ? site.startedAt : `${site.startedAt}–${year}`;
---

<footer class="relative mt-24 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-3">
          <Brand />
        </div>
        <p class="mt-5 max-w-md text-sm leading-[1.85] text-muted">{site.vision}</p>
      </div>

      <div>
        <p class="label-cjk mb-4 text-[12px] text-muted">导航</p>
        <ul class="space-y-2.5 text-sm">
          {
            footerNav.main.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-cjk mb-4 text-[12px] text-muted">相关</p>
        <ul class="space-y-2.5 text-sm">
          {
            footerNav.related.map((item) => (
              <li>
                <a href={item.href} class="text-muted transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/status/" class="text-muted transition-colors hover:text-ink">服务状态</a>
          </li>
          <li>
            <a href="/rss.xml" class="text-muted transition-colors hover:text-ink">RSS 订阅</a>
          </li>
          <li>
            <a
              href={site.github}
              rel="noopener noreferrer"
              target="_blank"
              class="text-muted transition-colors hover:text-ink">GitHub</a
            >
          </li>
          <!--
            友链挂在「相关」这一列，不单独占版面：一条链接就是全部内容。
            数据在 src/data/friends.ts，加友链只改那一处；外链统一新窗口打开。
          -->
          {
            friends.map((friend) => (
              <li>
                <a
                  href={friend.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={friend.desc}
                  class="text-muted transition-colors hover:text-ink"
                >
                  {friend.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Copyright © {yearRange} {site.name}（{site.nameEn}）· {site.domain} · All Rights Reserved.</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <!-- 隐私政策放在版权行旁：与常见做法一致的位置，全站每页都能到达 -->
        <a href="/privacy/" class="transition-colors hover:text-ink">隐私政策</a>
        <span aria-hidden="true" class="text-line-2">·</span>
        <a href={`mailto:${site.email}`} class="transition-colors hover:text-ink">{site.email}</a>
        <span class="font-serif text-[12px] tracking-[0.18em]">{site.slogan}</span>
      </p>
    </div>
  </div>
</footer>
