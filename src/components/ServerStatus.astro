---
import { isPlaceholder, site } from '../data/site';

interface Props {
  /**
   * 精简模式：不重复页面上已单独列出的连接信息（服务器地址、客户端版本），
   * 只展示实时查询到的内容。用于 Minecraft 页面。
   */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { javaIp, port, version } = site.minecraft;
const configured = !isPlaceholder(javaIp);
const address = isPlaceholder(port) ? javaIp : `${javaIp}:${port}`;
---

<div
  class="card flex h-full flex-col p-5"
  data-server-status
  data-ip={configured ? javaIp : ''}
  data-port={isPlaceholder(port) ? '' : port}
>
  <div class="flex items-center gap-2">
    <span class="status-dot" data-dot aria-hidden="true"></span>
    <span class="text-sm font-medium text-ink">Java 版服务器</span>
    <span class="ml-auto text-xs text-muted" data-status-text>
      {configured ? '查询中…' : '地址待公布'}
    </span>
  </div>

  <div class="mt-5 flex items-end gap-2">
    <span class="font-pixel text-3xl leading-none text-ink" data-online>—</span>
    <span class="pb-0.5 text-xs text-muted">
      / <span data-max>—</span> 人在线
    </span>
  </div>

  <dl class="mt-5 space-y-1.5 text-xs text-muted">
    {
      !compact && (
        <div class="flex justify-between gap-3">
          <dt>服务器地址</dt>
          <dd class="text-right font-mono">{configured ? address : '待填写'}</dd>
        </div>
      )
    }
    {
      !compact && (
        <div class="flex justify-between gap-3">
          <dt>服务端版本</dt>
          <dd class="text-right font-mono" data-version>
            {isPlaceholder(version) ? '—' : version}
          </dd>
        </div>
      )
    }
    <div class="flex justify-between gap-3">
      <dt>服务端核心</dt>
      <dd class="text-right font-mono" data-software>—</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt>查询耗时</dt>
      <dd class="text-right font-mono" data-latency>—</dd>
    </div>
    <div class="flex justify-between gap-3">
      <dt>最后检查</dt>
      <dd class="text-right font-mono" data-checked>—</dd>
    </div>
  </dl>

  <p class="mt-3 hidden text-[11px] leading-relaxed text-muted" data-note>
    查询服务（境外节点）无法连接这台服务器。可能是服务器不在线，也可能是它只对国内网络开放。
  </p>

  <button
    type="button"
    data-refresh
    class="mt-5 w-full rounded-md border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-primary/40 hover:text-primary"
  >
    刷新状态
  </button>
</div>

<script>
  function setText(root: Element, selector: string, value: string) {
    const el = root.querySelector(selector);
    if (el) el.textContent = value;
  }

  async function queryStatus(root: Element) {
    const ip = root.getAttribute('data-ip');
    if (!ip) return;

    const port = root.getAttribute('data-port') || '';
    const dot = root.querySelector('[data-dot]');
    const button = root.querySelector('[data-refresh]');

    setText(root, '[data-status-text]', '查询中…');
    if (button instanceof HTMLButtonElement) button.disabled = true;

    const started = performance.now();
    try {
      const res = await fetch(
        `https://api.mcsrvstat.us/3/${encodeURIComponent(ip)}${port ? ':' + port : ''}`,
        { cache: 'no-store' },
      );
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();

      setText(root, '[data-latency]', `${Math.round(performance.now() - started)} ms`);
      setText(
        root,
        '[data-checked]',
        new Date().toLocaleTimeString('zh-CN', { hour12: false }),
      );
      if (data && data.software) setText(root, '[data-software]', String(data.software));

      if (data && data.online) {
        dot?.classList.remove('status-offline');
        dot?.classList.add('status-online');
        setText(root, '[data-status-text]', '在线');
        setText(root, '[data-online]', String(data.players?.online ?? 0));
        setText(root, '[data-max]', String(data.players?.max ?? '—'));
        if (data.version) setText(root, '[data-version]', String(data.version));
      } else {
        dot?.classList.remove('status-online');
        dot?.classList.add('status-offline');
        setText(root, '[data-status-text]', '未响应');
        setText(root, '[data-online]', '—');
        setText(root, '[data-max]', '—');
        root.querySelector('[data-note]')?.classList.remove('hidden');
      }
    } catch {
      dot?.classList.remove('status-online');
      dot?.classList.add('status-offline');
      setText(root, '[data-status-text]', '暂时无法查询');
      setText(root, '[data-online]', '—');
      setText(root, '[data-max]', '—');
      root.querySelector('[data-note]')?.classList.remove('hidden');
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  }

  document.querySelectorAll('[data-server-status]').forEach((node) => {
    queryStatus(node);
    node.querySelector('[data-refresh]')?.addEventListener('click', () => queryStatus(node));
  });
</script>
