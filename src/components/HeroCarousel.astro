---
import { site } from '../data/site';

const slides = [
  {
    key: 'minecraft',
    tag: 'GAME',
    eyebrow: '新世界服务器 · NWM',
    title: ['2024 年开服，', '世界一直没重置过。'],
    desc: '当前版本 26.1.2，1.7 到 26.1 的任何客户端都能直接进。离线模式也能玩，领地保护和方块回滚守着你的家，被拆的东西能查、能还原。',
    primary: { label: '进入服务器', href: '/minecraft' },
    secondary: { label: '查看实时状态', href: '#server-status' },
    stats: [
      { k: '开服', v: '2024 年' },
      { k: '版本', v: '26.1.2' },
      { k: '在线上限', v: '30 人' },
      { k: '客户端', v: '1.7 – 26.1' },
    ],
    theme: 'mc',
  },
  {
    key: 'mod',
    tag: 'MOD',
    eyebrow: 'The Fire Rises · Add-on',
    title: ['钢铁雄心 4 的', 'The Fire Rises 附加内容。'],
    desc: '正在为 The Fire Rises 制作附加内容（Add-on），当前做的是重庆模式的债务相关国策与决议。',
    primary: { label: '了解内容', href: '/mod' },
    secondary: { label: '看看项目', href: '/projects' },
    stats: [
      { k: '载体', v: 'TFR Add-on' },
      { k: '游戏', v: 'Hearts of Iron IV' },
      { k: '内容', v: '债务国策决议' },
      { k: '发布', v: '暂不公开' },
    ],
    theme: 'mod',
  },
];
---

<section
  class="hero relative overflow-hidden border-b border-line"
  aria-roledescription="轮播"
  aria-label="站点两个方向"
>
  <div class="relative mx-auto max-w-6xl px-4 pt-9">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex flex-col gap-3">
        <p class="hero-badge">
          <span class="pip" aria-hidden="true"></span>
          Minecraft 服务器 · 钢铁雄心 4 Mod
        </p>
        <h1 class="text-[13px] font-medium tracking-[0.04em] text-muted sm:text-sm">
          <span class="font-bold tracking-[0.12em] text-strong">{site.name}</span>
          <span class="mx-2 text-muted">·</span>
          {site.slogan}
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <span class="font-pixel text-xs text-muted" data-hero-counter>01 / 02</span>
        <div class="flex gap-1.5">
          <button class="hero-arrow" type="button" data-hero-prev aria-label="上一页">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </button>
          <button class="hero-arrow" type="button" data-hero-next aria-label="下一页">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-track" data-hero-track tabindex="0" role="group" aria-label="可横向滚动的页面">
    {
      slides.map((slide, index) => (
        <article
          class={`hero-slide hero-slide--${slide.theme}`}
          data-hero-slide
          data-index={index}
          role="group"
          aria-roledescription="页面"
          aria-label={`${index + 1} / ${slides.length}：${slide.eyebrow}`}
        >
          <div class="relative mx-auto flex max-w-6xl items-center gap-12 px-4 pb-14 pt-10 sm:pb-20 sm:pt-14">
            <div class="relative max-w-3xl flex-1">
              <p class="hero-item font-pixel text-[11px] text-primary-2" style="--i:0">
                {slide.tag} · {slide.eyebrow}
              </p>

              <h2
                class="hero-item mt-5 text-[clamp(34px,5.4vw,58px)] font-extrabold leading-[1.06] tracking-[-0.04em] text-strong"
                style="--i:1"
              >
                {slide.title[0]}
                <br class="hidden sm:block" />
                {slide.title[1]}
              </h2>

              <p
                class="hero-item mt-7 max-w-xl text-[16.5px] leading-[1.85] tracking-[0.02em] text-muted"
                style="--i:2"
              >
                {slide.desc}
              </p>

              <div class="hero-item mt-9 flex flex-wrap items-center gap-3" style="--i:3">
                <a href={slide.primary.href} class="btn btn-accent btn-lg">{slide.primary.label}</a>
                <a href={slide.secondary.href} class="btn btn-standard btn-lg">
                  {slide.secondary.label}
                </a>
              </div>

              <dl
                class="hero-item mt-12 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4"
                style="--i:4"
              >
                {slide.stats.map((stat) => (
                  <div class="bg-bg px-5 py-4">
                    <dt class="font-pixel text-[10.5px] text-muted">{stat.k}</dt>
                    <dd class="mt-2 font-mono text-[21px] font-semibold leading-none text-strong">
                      {stat.v}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            <!-- 印章：唯一的 conic-gradient，只做旋转光边 -->
            <div class="hero-item hidden shrink-0 lg:block" style="--i:5">
              <div class="seal">
                <span>新</span>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-9">
    <div class="flex items-center gap-4">
      {
        slides.map((slide, index) => (
          <button
            class="hero-dot"
            type="button"
            data-hero-dot
            data-index={index}
            aria-label={`跳到第 ${index + 1} 页：${slide.eyebrow}`}
            aria-current={index === 0 ? 'true' : 'false'}
          >
            <span class="hero-dot__label">{slide.eyebrow}</span>
          </button>
        ))
      }
      <div class="hero-progress ml-auto hidden h-px w-28 overflow-hidden bg-line sm:block">
        <span class="hero-progress__bar block h-full w-0 bg-primary"></span>
      </div>
    </div>
    <p class="mt-5 font-pixel text-[11px] text-muted">{site.vision}</p>
  </div>
</section>

<style>
  /* 徽标胶囊：左侧一枚呼吸的红点 */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--color-line-2);
    border-radius: 999px;
    background: var(--color-soft);
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    align-self: flex-start;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .hero-badge .pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 12px var(--color-primary);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .hero-track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }

  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* 进场：只有当前页播放，逐条错开 */
  .hero-item {
    opacity: 1;
  }

  .hero-slide.is-active .hero-item {
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    background: transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .hero-arrow:hover {
    color: var(--color-ink);
    border-color: var(--color-line-2);
    background: var(--color-soft);
  }

  .hero-dot {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.12em;
    transition: color 0.2s var(--ease);
  }

  .hero-dot__label {
    position: relative;
    padding-bottom: 0.35rem;
  }

  .hero-dot__label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    border-radius: 999px;
    background: var(--color-primary);
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-dot[aria-current='true'] {
    color: var(--color-strong);
  }

  .hero-dot[aria-current='true'] .hero-dot__label::after {
    width: 100%;
  }

  .hero-dot:hover {
    color: var(--color-ink);
  }

  .hero-progress__bar {
    transition: width 0.35s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      scroll-behavior: auto;
    }
    .hero-slide.is-active .hero-item,
    .hero-badge .pip {
      animation: none;
    }
    .hero-progress__bar {
      transition: none;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 7000;

  document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const track = hero.querySelector<HTMLElement>('[data-hero-track]');
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const counter = hero.querySelector<HTMLElement>('[data-hero-counter]');
    const progress = hero.querySelector<HTMLElement>('.hero-progress__bar');
    if (!track || slides.length < 2) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let paused = false;

    const setActive = (index: number) => {
      current = index;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false'));
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
      if (progress) progress.style.width = `${((index + 1) / slides.length) * 100}%`;
    };

    const goTo = (index: number) => {
      const target = (index + slides.length) % slides.length;
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
      setActive(target);
    };

    const startAutoplay = () => {
      if (reduceMotion) return;
      stopAutoplay();
      timer = window.setInterval(() => {
        if (!paused && !document.hidden) goTo(current + 1);
      }, AUTOPLAY_MS);
    };
    const stopAutoplay = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      goTo(current - 1);
      startAutoplay();
    });
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      goTo(current + 1);
      startAutoplay();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.index ?? 0));
        startAutoplay();
      });
    });

    let scrollTimer: number | undefined;
    track.addEventListener('scroll', () => {
      if (scrollTimer) window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== current && index >= 0 && index < slides.length) setActive(index);
      }, 90);
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      }
    });

    ['pointerenter', 'focusin'].forEach((type) => hero.addEventListener(type, () => (paused = true)));
    ['pointerleave', 'focusout'].forEach((type) => hero.addEventListener(type, () => (paused = false)));

    window.addEventListener('resize', () =>
      track.scrollTo({ left: current * track.clientWidth, behavior: 'auto' }),
    );

    setActive(0);
    startAutoplay();
  });
</script>
