---
import { site } from '../data/site';

const slides = [
  {
    key: 'minecraft',
    tag: 'Minecraft',
    eyebrow: '新世界服务器 · NWM',
    title: ['新的世界，', '梦开始的地方'],
    desc: '新增 26.1.2 版本支持，服务器幽灵已上线',
    primary: { label: '进入服务器', href: '/minecraft/' },
    secondary: { label: '查看实时状态', href: '#server-status' },
    art: 'grass',
    theme: 'mc',
  },
  {
    key: 'mod',
    tag: 'MOD',
    eyebrow: 'The Fire Rises · Add-on',
    title: ['2026，', '燃起柴薪'],
    desc: '正在为钢铁雄心4：TFR 制作附加内容，更新重庆模式的债务相关国策与决议。',
    primary: { label: '了解内容', href: '/mod/' },
    secondary: { label: '看看项目', href: '/projects/' },
    art: 'flag',
    theme: 'mod',
  },
];
---

<section
  class="hero relative overflow-hidden border-b border-line"
  aria-roledescription="轮播"
  aria-label="站点两个方向"
>
  <!-- 站点主标题：只给搜索引擎与读屏用，不在页面上显示 -->
  <h1 class="sr-only">{site.name} · {site.slogan}</h1>

  <div class="relative mx-auto max-w-6xl px-4 pt-7">
    <div class="flex items-center justify-end gap-3">
      <span class="label-latin text-xs text-muted" data-hero-counter>01 / 02</span>
      <div class="flex gap-1.5">
        <button
          class="hero-arrow"
          type="button"
          data-hero-pause
          aria-label="暂停自动播放"
          aria-pressed="false"
        >
          <svg
            class="hero-pause-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M9.5 5v14M14.5 5v14"></path>
          </svg>
          <svg
            class="hero-play-icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
            stroke="none"
            aria-hidden="true"
          >
            <path d="M8 5.2l10.5 6.8L8 18.8z"></path>
          </svg>
        </button>
        <button class="hero-arrow" type="button" data-hero-prev aria-label="上一页">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <button class="hero-arrow" type="button" data-hero-next aria-label="下一页">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hero-track" data-hero-track tabindex="0" role="group" aria-label="可横向滚动的页面">
    {
      slides.map((slide, index) => (
        <article
          class={`hero-slide hero-slide--${slide.theme}`}
          data-hero-slide
          data-index={index}
          role="group"
          aria-roledescription="页面"
          aria-label={`${index + 1} / ${slides.length}：${slide.eyebrow}`}
        >
          <div class="relative mx-auto flex max-w-6xl items-center gap-12 px-4 pb-10 pt-10 sm:pb-14 sm:pt-12">
            <div class="relative z-10 max-w-3xl flex-1">
              <p class="hero-item label-latin text-[11px] text-primary-2" style="--i:0">
                {slide.tag}
                <span class="label-cjk"> · {slide.eyebrow}</span>
              </p>

              <h2
                class="hero-item mt-5 text-[clamp(34px,5.4vw,58px)] font-extrabold leading-[1.06] tracking-[-0.04em] text-strong"
                style="--i:1"
              >
                {slide.title[0]}
                <br class="hidden sm:block" />
                {slide.title[1]}
              </h2>

              <p
                class="hero-item mt-7 max-w-xl text-[16.5px] leading-[1.85] tracking-[0.02em] text-muted"
                style="--i:2"
              >
                {slide.desc}
              </p>

              <div class="hero-item mt-9 flex flex-wrap items-center gap-3" style="--i:3">
                <a href={slide.primary.href} class="btn btn-accent btn-lg">{slide.primary.label}</a>
                <a href={slide.secondary.href} class="btn btn-standard btn-lg">
                  {slide.secondary.label}
                </a>
              </div>

            </div>

            <!--
              右侧图示：Minecraft 用草方块，钢铁雄心 4 用方形国旗。
              窄屏没有空间并排，改成右上角的淡水印；桌面端回到正常位置与不透明度。
              边长取 96 / 128px —— 草方块是 16 格的像素网格，必须是 16 的整数倍，
              否则叠加 shape-rendering="crispEdges" 后每格宽窄不一。
            -->
            <div
              class="hero-item pointer-events-none absolute right-1 top-3 opacity-[0.14] lg:static lg:opacity-100"
              style="--i:5"
            >
              {slide.art === 'grass' ? (
                <svg
                  class="h-24 w-24 drop-shadow-[0_10px_24px_rgba(31,29,26,0.18)] lg:h-32 lg:w-32"
                  viewBox="0 0 16 16"
                  shape-rendering="crispEdges"
                  role="img"
                  aria-label="草方块"
                >
                  <rect x="0" y="4" width="16" height="12" fill="#8D6E63" />
                  <rect x="0" y="0" width="16" height="4" fill="#7CB342" />
                  <rect x="0" y="0" width="16" height="1" fill="#8BC34A" />
                  <rect x="0" y="3" width="16" height="1" fill="#689F38" />
                  <rect x="0" y="4" width="2" height="1" fill="#689F38" />
                  <rect x="4" y="4" width="2" height="1" fill="#689F38" />
                  <rect x="8" y="4" width="2" height="1" fill="#689F38" />
                  <rect x="12" y="4" width="2" height="1" fill="#689F38" />
                  <rect x="2" y="6" width="1" height="1" fill="#795548" />
                  <rect x="6" y="8" width="1" height="1" fill="#A1887F" />
                  <rect x="10" y="6" width="1" height="1" fill="#795548" />
                  <rect x="3" y="11" width="1" height="1" fill="#6D4C41" />
                  <rect x="8" y="12" width="1" height="1" fill="#A1887F" />
                  <rect x="13" y="9" width="1" height="1" fill="#795548" />
                  <rect x="5" y="14" width="1" height="1" fill="#6D4C41" />
                  <rect x="11" y="14" width="1" height="1" fill="#A1887F" />
                  <rect x="0" y="4" width="1" height="12" fill="#ffffff" opacity="0.14" />
                  <rect x="15" y="4" width="1" height="12" fill="#000000" opacity="0.14" />
                </svg>
              ) : (
                <svg
                  class="h-24 w-24 rounded-[2px] drop-shadow-[0_10px_24px_rgba(31,29,26,0.24)] lg:h-32 lg:w-32"
                  viewBox="0 0 30 30"
                  role="img"
                  aria-label="方形国旗"
                >
                  <rect width="30" height="30" fill="#DE2910" />
                  <g fill="#FFDE00">
                    <polygon points="6.5,4.8 7.44,7.71 10.49,7.7 8.02,9.49 8.97,12.4 6.5,10.6 4.03,12.4 4.98,9.49 2.51,7.7 5.56,7.71" />
                    <polygon points="0,-1.5 0.32,-0.45 1.42,-0.45 0.53,0.2 0.86,1.25 0,0.6 -0.86,1.25 -0.53,0.2 -1.42,-0.45 -0.32,-0.45" transform="translate(12.5 4.8) rotate(-125)" />
                    <polygon points="0,-1.5 0.32,-0.45 1.42,-0.45 0.53,0.2 0.86,1.25 0,0.6 -0.86,1.25 -0.53,0.2 -1.42,-0.45 -0.32,-0.45" transform="translate(15.5 7.8) rotate(-98)" />
                    <polygon points="0,-1.5 0.32,-0.45 1.42,-0.45 0.53,0.2 0.86,1.25 0,0.6 -0.86,1.25 -0.53,0.2 -1.42,-0.45 -0.32,-0.45" transform="translate(15.5 12.2) rotate(-70)" />
                    <polygon points="0,-1.5 0.32,-0.45 1.42,-0.45 0.53,0.2 0.86,1.25 0,0.6 -0.86,1.25 -0.53,0.2 -1.42,-0.45 -0.32,-0.45" transform="translate(12.5 15.2) rotate(-44)" />
                  </g>
                </svg>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- 进度条：3px 圆头色条，点击可跳转到第 n 屏 -->
  <div class="relative mx-auto max-w-6xl px-4 pb-10">
    <button
      class="hero-progress"
      type="button"
      data-hero-progress
      aria-label="轮播进度，点击可切换页面"
    >
      <span class="hero-progress__track">
        <span class="hero-progress__bar" data-hero-bar></span>
      </span>
    </button>
  </div>
</section>

<style>
  .hero-track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
  }

  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* 进场：只有当前页播放，逐条错开 */
  .hero-item {
    opacity: 1;
  }

  .hero-slide.is-active .hero-item {
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    background: transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .hero-arrow:hover {
    color: var(--color-ink);
    border-color: var(--color-line-2);
    background: var(--color-soft);
  }

  /* 暂停 / 播放图标按 aria-pressed 切换 */
  .hero-pause-icon {
    display: block;
  }

  .hero-play-icon {
    display: none;
  }

  .hero-arrow[aria-pressed='true'] .hero-pause-icon {
    display: none;
  }

  .hero-arrow[aria-pressed='true'] .hero-play-icon {
    display: block;
  }

  /* 3px 色条 + 上下 8px 透明内边距，点得到 */
  .hero-progress {
    display: block;
    width: 112px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hero-progress__track {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: var(--color-line);
    overflow: hidden;
  }

  .hero-progress__bar {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--color-primary);
    transition: width 0.5s var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      scroll-behavior: auto;
    }
    .hero-slide.is-active .hero-item {
      animation: none;
    }
    .hero-progress__bar {
      transition: none;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 7000;

  document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const track = hero.querySelector<HTMLElement>('[data-hero-track]');
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const counter = hero.querySelector<HTMLElement>('[data-hero-counter]');
    const bar = hero.querySelector<HTMLElement>('[data-hero-bar]');
    const pauseButton = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const progressButton = hero.querySelector<HTMLButtonElement>('[data-hero-progress]');
    if (!track || slides.length < 2) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let hoverPaused = false;
    let userPaused = false;

    const setActive = (index: number) => {
      current = index;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
      if (bar) bar.style.width = `${((index + 1) / slides.length) * 100}%`;
    };

    const goTo = (index: number) => {
      const target = (index + slides.length) % slides.length;
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
      setActive(target);
    };

    const startAutoplay = () => {
      if (reduceMotion) return;
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(() => {
        if (!hoverPaused && !userPaused && !document.hidden) goTo(current + 1);
      }, AUTOPLAY_MS);
    };

    /**
     * 手动暂停：WCAG 2.2.2 要求自动播放的内容可以暂停。
     * 一旦用户自己按了暂停、或手动翻过页，就不再自动继续。
     */
    const setUserPaused = (value: boolean) => {
      userPaused = value;
      pauseButton?.setAttribute('aria-pressed', String(value));
      pauseButton?.setAttribute('aria-label', value ? '继续自动播放' : '暂停自动播放');
    };

    if (reduceMotion && pauseButton) {
      // 减少动效时本来就不自动播放，暂停按钮没有意义
      pauseButton.hidden = true;
    }

    pauseButton?.addEventListener('click', () => {
      setUserPaused(!userPaused);
      if (!userPaused) startAutoplay();
    });

    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
      goTo(current - 1);
      setUserPaused(true);
    });
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => {
      goTo(current + 1);
      setUserPaused(true);
    });

    progressButton?.addEventListener('click', (event) => {
      const rect = progressButton.getBoundingClientRect();
      const ratio = (event.clientX - rect.left) / rect.width;
      goTo(Math.floor(ratio * slides.length));
      setUserPaused(true);
    });

    let scrollTimer: number | undefined;
    track.addEventListener('scroll', () => {
      if (scrollTimer) window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== current && index >= 0 && index < slides.length) setActive(index);
      }, 90);
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      }
    });

    ['pointerenter', 'focusin'].forEach((type) =>
      hero.addEventListener(type, () => (hoverPaused = true)),
    );
    ['pointerleave', 'focusout'].forEach((type) =>
      hero.addEventListener(type, () => (hoverPaused = false)),
    );

    window.addEventListener('resize', () =>
      track.scrollTo({ left: current * track.clientWidth, behavior: 'auto' }),
    );

    setActive(0);
    startAutoplay();
  });
</script>
