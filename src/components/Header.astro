---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} 首页`}>
      <span class="grid h-10 w-10 shrink-0 grid-cols-2 grid-rows-2 gap-[3px]" aria-hidden="true">
        <i class="rounded-[3px] bg-primary"></i>
        <i class="rounded-[3px] bg-cyan"></i>
        <i class="rounded-[3px] bg-secondary"></i>
        <i class="rounded-[3px] bg-accent"></i>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-semibold tracking-wide">{site.name}</span>
        <span class="font-pixel mt-0.5 text-[10px] text-muted">{site.nameEn}</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-0.5 lg:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-soft text-primary'
                : 'text-muted hover:bg-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-3">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="rounded-md border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        菜单
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line lg:hidden">
    <nav class="mx-auto grid max-w-6xl grid-cols-2 gap-1 px-4 py-3" aria-label="移动端导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm',
              isActive(item.href) ? 'bg-soft text-primary' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        panel.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
