---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const menu = nav;
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent transition-colors duration-300"
  style="background: var(--acrylic); backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
    <a href="/" class="flex flex-none items-center gap-3" aria-label={`${site.name} 首页`}>
      <img
        src="/favicon.svg"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 shrink-0"
        aria-hidden="true"
      />
      <span class="flex flex-col leading-none">
        <strong class="text-[14.5px] font-bold tracking-[0.14em] text-strong">{site.name}</strong>
        <span class="font-pixel mt-1 text-[9.5px] text-muted">{site.nameEn}</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-0.5 lg:flex" aria-label="主导航">
      {
        menu.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-[13.5px] tracking-[0.08em] transition-colors',
              isActive(item.href)
                ? 'bg-soft text-strong'
                : 'text-muted hover:bg-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-4">
      <a href="/minecraft" class="btn btn-accent btn-sm hidden sm:inline-flex">进入服务器</a>
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="btn btn-standard btn-sm lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        菜单
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line lg:hidden">
    <nav class="mx-auto grid max-w-6xl grid-cols-2 gap-1 px-4 py-3" aria-label="移动端导航">
      {
        menu.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm',
              isActive(item.href) ? 'bg-soft text-strong' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // 滚动后才出现下边框（与 Microsoft Fluent 一致）
  const navEl = document.getElementById('site-nav');
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      window.requestAnimationFrame(() => {
        navEl?.classList.toggle('border-line', window.scrollY > 6);
        ticking = false;
      });
      ticking = true;
    },
    { passive: true },
  );

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        panel.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
