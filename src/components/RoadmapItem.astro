---
interface Props {
  phase: string;
  period: string;
  title: string;
  status: string;
  items: readonly string[];
}

const { phase, period, title, status, items } = Astro.props;

const statusLabel =
  status === 'in-progress' ? '进行中' : status === 'done' ? '已完成' : '规划中';
const statusClass =
  status === 'in-progress'
    ? 'badge badge-primary'
    : status === 'done'
      ? 'badge badge-primary'
      : 'badge';
---

<article class="relative border-l border-line pl-6 pb-10 last:pb-0">
  <span
    class:list={[
      'absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full',
      status === 'planned' ? 'bg-line' : 'bg-primary',
    ]}
    aria-hidden="true"></span>

  <div class="mb-2 flex flex-wrap items-center gap-2">
    <span class="font-pixel text-xs text-muted">{phase}</span>
    <span class={statusClass}>{statusLabel}</span>
    <span class="text-xs text-muted">{period}</span>
  </div>

  <h3 class="text-base font-semibold text-white">{title}</h3>
  <ul class="mt-3 space-y-1.5 text-sm text-muted">
    {
      items.map((item) => (
        <li class="flex gap-2">
          <span class="text-primary" aria-hidden="true">▸</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</article>
