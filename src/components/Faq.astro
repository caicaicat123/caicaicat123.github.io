---
import SectionHeading from './SectionHeading.astro';

interface Props {
  /** 区块英文标签（如 FAQ） */
  eyebrow?: string;
  /** 区块标题 */
  title?: string;
  /** 区块导语：一句话给结论 */
  desc?: string;
  items: readonly { q: string; a: string }[];
}

const {
  eyebrow = 'FAQ',
  title = '常见问题',
  desc = undefined,
  items,
} = Astro.props;

/**
 * FAQPage 结构化数据：与下方正文同源，避免两处文案漂移。
 * 转义 `<` 是防止答案里出现 `</script>` 之类内容截断脚本块。
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="band border-y border-line">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow={eyebrow} title={title} desc={desc} descAs="p" />
    <!--
      连续说明不用卡片：卡片是一种「同类并置项」的形状，
      把十几条问答各自包进圆角盒，等于让形状不再携带信息。
      这里改用「一条 1px 线 + 留白」分段 —— 与隐私政策的条款、规则清单同一种语汇。
    -->
    <div class="divide-y divide-line border-y border-line">
      {
        items.map((item) => (
          <article class="py-6">
            <h2 class="text-base font-semibold text-strong">{item.q}</h2>
            <p class="mt-2 text-base leading-[1.85] text-muted">{item.a}</p>
          </article>
        ))
      }
    </div>
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')}
  />
</section>
