---
interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  /** 标题标签：页面主标题传 h1，区块标题保持默认 h2 */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, desc, as = 'h2' } = Astro.props;
const Heading = as;
---

<div class="mb-14 max-w-2xl">
  {
    eyebrow && (
      <p class="section-label">{eyebrow}</p>
    )
  }
  <Heading class="text-[clamp(28px,3.6vw,40px)] font-medium leading-[1.16] tracking-[-0.03em] text-strong">
    {title}
  </Heading>
  {desc && <p class="mt-4 text-base leading-[1.85] tracking-[0.02em] text-muted">{desc}</p>}
</div>
