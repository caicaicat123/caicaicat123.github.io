---
interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
}

const { eyebrow, title, desc } = Astro.props;
---

<div class="mb-8">
  {
    eyebrow && (
      <p class="font-pixel mb-2 text-xs tracking-wider text-primary">{eyebrow}</p>
    )
  }
  <h2 class="text-xl font-semibold text-white sm:text-2xl">{title}</h2>
  {desc && <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{desc}</p>}
</div>
