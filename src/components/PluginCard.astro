---
interface Props {
  name: string;
  tag: string;
  /** 正式版版本号 */
  version: string;
  platform: string;
  status: string;
  desc: string;
  /** 正式版下载 */
  download: { label: string; href: string };
  /**
   * 可选的测试版（GitHub prerelease）。
   * 两个版本并列时：正式版是实色主按钮，测试版是玻璃次按钮 + 「测试版」徽章 ——
   * 按钮层级本身就是「我该点哪个」的答案，不需要额外文案解释。
   */
  beta?: { version: string; label: string; href: string; note?: string };
}

const { name, tag, version, platform, status, desc, download, beta } = Astro.props;

// 完成态用竹青，与全站的状态语义保持一致（见 global.css 的 .badge-jade）
const statusClass = status === '长期维护' ? 'badge badge-jade' : 'badge badge-primary';
// 卡片顶部 3px 的状态条用材质色：这是与「插件在服务器上的状态」绑定的位置，
// 属于材质色被允许出现的场景（见 global.css 的 --m-* 令牌说明）。
const barColor = status === '长期维护' ? 'var(--m-grass)' : 'var(--m-copper)';
---

<article class="card flex h-full flex-col overflow-hidden p-6" style={`--status-bar: ${barColor}`}>
  <span aria-hidden="true" class="plugin-status-bar"></span>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <!-- 插件标识是分类，不是强调内容：用中性 badge，把朱砂留给真正要抓眼的地方 -->
    <span class="badge label-latin">{tag}</span>
    <span class={statusClass}>{status}</span>
  </div>
  <!-- 每张卡是一个插件（独立主题），在区块 h2 之下用 h3 才有无歧义的层级 -->
  <h3 class="text-lg font-semibold text-strong">{name}</h3>
  <p class="mt-3 flex-1 text-base leading-relaxed text-muted">{desc}</p>
  <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-line pt-4 text-sm">
    <div>
      <dt class="text-xs text-muted">正式版</dt>
      <dd class="mt-0.5 font-mono text-ink">{version}</dd>
    </div>
    <div>
      <dt class="text-xs text-muted">适用服务端</dt>
      <dd class="mt-0.5 text-ink">{platform}</dd>
    </div>
  </dl>

  {
    beta && (
      <div class="mt-4 rounded-[4px] border border-line bg-soft px-3 py-2.5">
        <p class="flex flex-wrap items-center gap-2 text-xs text-muted">
          <span class="badge badge-primary">测试版</span>
          <span class="font-mono text-ink">{beta.version}</span>
        </p>
        {beta.note && <p class="mt-1.5 text-xs leading-relaxed text-muted">{beta.note}</p>}
      </div>
    )
  }

  <div class="mt-5 flex flex-col gap-2">
    <a href={download.href} class="btn btn-accent w-full justify-center">
      {download.label}
      <span class="sr-only">（{name} 正式版 {version}，jar 文件）</span>
    </a>
    {
      beta && (
        <a href={beta.href} class="btn btn-standard w-full justify-center">
          {beta.label}
          <span class="sr-only">（{name} 测试版 {beta.version}，jar 文件）</span>
        </a>
      )
    }
  </div>
</article>

<style>
  /* 顶部状态条：唯一在卡片上出现的材质色。
     它不是装饰 —— 颜色对应插件在服务器上的实际状态（长期维护 = 草绿 / 进行中 = 铜橙）。 */
  .plugin-status-bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--status-bar, var(--m-stone));
  }

  article {
    position: relative;
  }
</style>
