---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';

const values = [
  {
    title: '先做出来，再做好',
    desc: '不追求一次到位，先把闭环跑通，再逐步打磨细节。',
  },
  {
    title: '过程公开',
    desc: '选型理由、失败尝试和踩坑记录尽量留下，方便别人少走弯路。',
  },
  {
    title: '可持续优先',
    desc: '服务器长期运营，项目节奏不靠透支热情，靠能持续的机制。',
  },
];
---

<BaseLayout
  title="关于"
  description="新世界网络（New World Network）工作室介绍、愿景与做事方式。"
>
  <section class="mx-auto max-w-4xl px-4 py-14">
    <p class="font-pixel mb-3 text-xs tracking-wider text-primary">ABOUT</p>
    <h1 class="text-2xl font-semibold text-strong sm:text-3xl">关于 {site.name}</h1>
    <p class="mt-5 text-base leading-relaxed text-muted sm:text-base">
      {site.description}
    </p>

    <div class="card mt-8 border-l-2 border-l-primary p-6">
      <p class="font-pixel mb-2 text-xs text-primary">VISION</p>
      <p class="text-base leading-relaxed text-ink">{site.vision}</p>
      <p class="mt-4 text-sm text-muted">
        Slogan：{site.slogan}
      </p>
    </div>

    <div class="mt-12">
      <SectionHeading eyebrow="HOW WE WORK" title="做事方式" />
      <div class="grid gap-5 sm:grid-cols-3">
        {
          values.map((value) => (
            <div class="card p-5">
              <h3 class="text-sm font-semibold text-strong">{value.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-muted">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12">
      <SectionHeading eyebrow="MEMBERS" title="成员" desc="工作室目前由一个人运营。" />
      <div class="card p-6">
        <p class="text-sm font-semibold text-strong">断了一只爪子的招财猫</p>
        <p class="font-pixel mt-1 text-xs text-muted">创始人 / 唯一成员</p>
        <p class="text-base leading-relaxed text-muted">
          服务器运维、插件开发、网站与 Mod 开发，目前都由我一个人在做。
          所以这个站点既是门面，也是我的工作台。
        </p>
        <p class="mt-3 text-base leading-relaxed text-muted">
          工作室自 2024 年运营《我的世界》服务器起持续至今。
        </p>
      </div>
    </div>

    <div class="mt-12">
      <a href="/contact" class="btn btn-accent">联系方式</a>
    </div>
  </section>
</BaseLayout>
