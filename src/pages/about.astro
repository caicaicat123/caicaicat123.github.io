---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { positioning } from '../data/minecraft';
---

<BaseLayout
  title="关于"
  description="新世界网络（New World Network）工作室介绍与愿景。"
>
  <section class="mx-auto max-w-4xl px-4 py-14">
    <p class="label-latin mb-3 text-xs text-primary">ABOUT</p>
    <h1 class="text-2xl font-semibold text-strong sm:text-3xl">关于 {site.name}</h1>
    <p class="mt-5 text-base leading-relaxed text-muted sm:text-base">
      {site.description}
    </p>

    <div class="card mt-8 border-l-2 border-l-primary p-6">
      <p class="label-latin mb-2 text-xs text-primary">VISION</p>
      <p class="text-base leading-relaxed text-ink">{site.vision}</p>
      <p class="mt-4 text-sm text-muted">
        Slogan：{site.slogan}
      </p>
    </div>

    <!-- 服务器定位：与服务器页、插件页共用同一份文案（来自 data/minecraft.ts 的 positioning） -->
    <div class="mt-8">
      <SectionHeading
        title="我们在运营一台什么样的服务器？"
        desc={positioning}
        descAs="p"
      />
      <div class="flex flex-wrap gap-3">
        <a href="/minecraft/" class="btn btn-accent">服务器详情</a>
        <a href="/plugins/" class="btn btn-standard">我们的插件</a>
      </div>
    </div>

    <div class="mt-12">
      <SectionHeading eyebrow="MEMBERS" title="成员" desc="工作室目前由一个人运营。" />
      <div class="card p-6">
        <p class="text-sm font-semibold text-strong">断了一只爪子的招财猫</p>
        <p class="label-cjk mt-1 text-xs text-muted">创始人 / 唯一成员</p>
        <p class="mt-3 text-base leading-relaxed text-muted">
          工作室自 2023 年 6 月 21 日运营《我的世界》服务器起持续至今。
        </p>
      </div>
    </div>

    <div class="mt-12">
      <a href="/contact/" class="btn btn-accent">联系方式</a>
    </div>
  </section>
</BaseLayout>
