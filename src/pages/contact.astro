---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CopyButton from '../components/CopyButton.astro';
import { isPlaceholder, site } from '../data/site';

const channels = [
  {
    label: '电子邮箱',
    value: site.email,
    note: '合作、反馈与问题举报都走这个入口。',
    copy: true,
  },
  {
    label: 'QQ 群',
    value: site.community.qq,
    note: '玩家与开发者交流的主要阵地。',
    copy: true,
  },
  {
    label: 'Discord',
    value: site.community.discord,
    note: '国际用户与开源协作入口。',
    copy: true,
  },
];
---

<BaseLayout title="联系" description="新世界网络的联系方式：邮箱、社区群与 GitHub。">
  <section class="mx-auto max-w-4xl px-4 py-14">
    <SectionHeading
      eyebrow="CONTACT"
      title="联系我们"
      desc="欢迎反馈问题、提建议，或者申请加入服务器。"
    />

    <div class="grid gap-5 sm:grid-cols-2">
      {
        channels.map((channel) => (
          <div class="card p-5">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-sm font-semibold text-white">{channel.label}</h2>
              {channel.copy && <CopyButton value={channel.value} label="复制" tone="ghost" />}
            </div>
            <p class="mt-3 font-mono text-sm text-ink">
              {isPlaceholder(channel.value) ? '待填写' : channel.value}
            </p>
            <p class="mt-2 text-xs leading-relaxed text-muted">{channel.note}</p>
          </div>
        ))
      }

      <div class="card p-5">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-white">GitHub</h2>
        </div>
        <p class="mt-3 font-mono text-sm text-ink">caicaicat123</p>
        <p class="mt-2 text-xs leading-relaxed text-muted">代码仓库与开源项目。</p>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-sm text-primary transition-opacity hover:opacity-80"
        >
          打开 GitHub →
        </a>
      </div>
    </div>

    <div class="card mt-8 p-6">
      <p class="text-sm leading-relaxed text-muted">
        标记为「待填写」的入口仍在确认中，确认后会第一时间在本页更新。
        急事也可以直接在 GitHub 上开 Issue 找到我们。
      </p>
    </div>
  </section>
</BaseLayout>
