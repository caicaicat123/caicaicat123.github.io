---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CopyButton from '../components/CopyButton.astro';
import { site } from '../data/site';

const channels = [
  {
    label: '电子邮箱',
    value: site.email,
    note: '合作、反馈与问题举报都走这个入口。',
  },
  {
    label: 'QQ 群',
    value: site.community.qq,
    note: '玩家与开发者交流的主要阵地，服务器公告也在这里。',
  },
];
---

<BaseLayout title="联系" description="新世界网络的联系方式：邮箱、QQ 群与 GitHub。">
  <section class="mx-auto max-w-4xl px-4 py-14">
    <SectionHeading
      as="h1"
      eyebrow="CONTACT"
      title="联系我们"
      desc="欢迎反馈问题、提建议，或者申请加入服务器。"
    />

    <div class="grid gap-5 sm:grid-cols-2">
      {
        channels.map((channel) => (
          <div class="card p-5">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-sm font-semibold text-strong">{channel.label}</h2>
              <CopyButton value={channel.value} label="复制" tone="ghost" />
            </div>
            <p class="mt-3 break-all font-mono text-sm text-ink">{channel.value}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted">{channel.note}</p>
          </div>
        ))
      }

      <div class="card p-5">
        <h2 class="text-sm font-semibold text-strong">GitHub</h2>
        <p class="mt-3 font-mono text-sm text-ink">caicaicat123</p>
        <p class="mt-2 text-xs leading-relaxed text-muted">代码仓库与开源项目。</p>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-sm text-primary transition-opacity hover:opacity-80"
        >
          打开 GitHub →
        </a>
      </div>

      <div class="card p-5">
        <h2 class="text-sm font-semibold text-strong">Minecraft</h2>
        <p class="mt-3 font-mono text-sm text-ink">
          {site.minecraft.javaIp}:{site.minecraft.port}
        </p>
        <p class="mt-2 text-xs leading-relaxed text-muted">
          Java 版 {site.minecraft.version}，离线可进。
        </p>
        <a
          href="/minecraft"
          class="mt-4 inline-block text-sm text-primary transition-opacity hover:opacity-80"
        >
          服务器详情 →
        </a>
      </div>
    </div>

    <div class="card mt-8 p-6">
      <p class="text-base leading-relaxed text-muted">
        工作室目前由一个人运营，回复可能不及时，但每封邮件都会看。
        急事也可以直接在 GitHub 上开 Issue。
      </p>
    </div>
  </section>
</BaseLayout>
