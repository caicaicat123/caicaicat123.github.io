---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { dungeonRelease } from '../../data/plugins';

/** 与插件 plugin.yml 的版本一致；改版本时同步这一处 */
const version = dungeonRelease.version;

const configurationExample = "schema-version: 2\nid: mine                       # 唯一副本ID；修改ID会被视为另一个副本\nkind: generated                # generated=程序地图；template=编辑器自建地图\nname: '&6废弃矿洞'              # 副本显示名\nicon: IRON_BLOCK\n\nentrance:\n  random-generation: true\n  worlds: [world]              # 留空列表表示服从全局世界名单\n  block: IRON_BLOCK            # 程序入口的难度标记方块\n  weight: 10                  # 10 / 所有可用入口权重之和；不是固定10%\n\nsettings:\n  time-limit-minutes: 20\n  stamina-cost: 25\n  money-reward: 1000\n\nrooms:\n  - id: 1                     # 从1开始，按顺序连续编号\n    name: '&e矿洞入口'          # 玩家进入这一关时，显示在屏幕上的Title\n    waves:\n      - mobs:                 # 第一波\n          ZOMBIE: 3\n          SKELETON: 2\n      - mobs:                 # 第二波\n          HUSK: 2\n  - id: 2\n    name: '&c矿洞深处'\n    boss: true                # 只有最后一间房写true\n    waves:                    # 首领登场前的小怪波；直接出首领可写 waves: []\n      - mobs:\n          ZOMBIE: 2\n\nboss:\n  type: HUSK\n  name: '&6矿洞监工'\n  guards:                     # 前置波清完后，与首领同时出现\n    ZOMBIE: 2\n\n  attributes:                 # 首领属性单独一栏\n    health: 160               # 生命值点数；20点=10颗心；支持小数\n    damage: 8                 # 基础攻击力，还会受武器与效果影响\n    movement-speed: 0.23\n    armor: 6\n    legacy-strength: false    # 迁移旧版时为true，保留原来的强度/抗性效果\n\n  equipment:                  # 首领装备与附魔单独一栏\n    mainhand:\n      item: IRON_AXE\n      enchants:\n        sharpness: 2\n    helmet:\n      item: IRON_HELMET\n  equipment-drop-chance: 0.0  # 装备掉落概率；0=不掉\n\nrewards:\n  supply:                     # 关卡补给池；空列表[]表示不放物品\n    - item: BREAD\n      weight: 3\n      min: 1\n      max: 3\n  completion:                 # 通关奖励池\n    - item: DIAMOND\n      weight: 1\n      min: 1\n      max: 2\n      chance: 0.3             # 30%概率进入本次候选池，之后仍参与weight抽取";

const toc = [
  { id: 'download', label: '下载与版本' },
  { id: 'upgrade', label: '安装与升级' },
  { id: 'configuration', label: '新版配置与样例' },
  { id: 'mythic', label: 'MythicMobs 接入' },
  { id: 'runtime', label: '生成与首领血量' },
  { id: 'performance', label: '准备速度配置' },
  { id: 'what', label: '这是什么' },
  { id: 'commands', label: '命令与权限' },
  { id: 'quickstart', label: '快速上手' },
  { id: 'panels', label: '四个面板' },
  { id: 'markers', label: '标记的语义' },
  { id: 'entrance', label: '入口建筑' },
  { id: 'files', label: '数据与文件' },
  { id: 'limits', label: '已知限制' },
  { id: 'faq', label: '常见问题' },
];
---

<BaseLayout
  title="随机副本 - 支持文档"
  description="NWNDungeon 1.5.1 正式版支持文档：新版 YAML 配置完整样例、旧配置备份转换、MythicMobs 接入、首领血量与装备附魔、安装升级和编辑器说明。"
>
  <DocsLayout
    title="随机副本支持文档"
    intro="1.5.1 使用一个副本一个 YAML 的新版配置，并可接入 MythicMobs。这里提供完整配置样例、旧服转换步骤、血量管理规则及自建地图操作说明。"
    version={version}
    status="stable"
    toc={toc}
  >
    <h2 id="download">下载与版本</h2>
    <p>
      当前正式版为 <strong>{version}</strong>，发布于 <time datetime="2026-10-24">2026 年 10 月 24 日</time>。
      包含新版配置、备份转换、MythicMobs 5.x 可选接入，并保留内置副本、管理员自建副本及生成保护。
      <a href="/plugins/">插件页</a>只保留一个最新版下载按钮。
    </p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>版本</th><th>包含内容</th><th>配置兼容</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>正式版 <span class="font-mono">{version}</span></td>
          <td>新版配置 + 备份转换 + MythicMobs接入 + 原有副本功能</td>
          <td>新安装使用新版；旧格式仍可读，可用 /nwd migrate 转换</td>
        </tr>
      </tbody>
    </table></div>
    <p>
      完整更新记录和校验文件见 <a href={dungeonRelease.releaseUrl}>GitHub 正式发布页</a>。
      通过 134 项离线检查、26 项新配置专项、34 项真实 Mythic 专项，以及视距/模拟距离均为 3 的隔离服 67 项自检；
      不同服务端与插件组合仍应先在自己的测试环境验证。
    </p>

    <h2 id="upgrade">安装与升级</h2>
    <ol>
      <li>备份旧 JAR 和 <code>plugins/NWNDungeon/</code> 数据目录。</li>
      <li>完整停止服务器，替换 JAR，并移走同插件的旧 JAR，避免重复加载。</li>
      <li>启动服务器，确认插件版本为 <span class="font-mono">{version}</span>，核对「启动配置校验完成」及各难度首领血量。</li>
      <li>旧服执行 <code>/nwd migrate</code>，先备份再转换到 <code>dungeons/</code>；重复执行不会覆盖已有新版文件。也可暂时继续使用旧格式。</li>
      <li>执行 <code>/nwd doctor</code>，再验证一局清波、首领血量与血条、奖励和退出。</li>
    </ol>
    <p class="callout">
      换 JAR 必须完整重启。<code>/nwd reload</code>只重载配置，不能把正在运行的旧插件代码换成新版。
      每次启动都会从磁盘加载并校验配置；校验失败会停用副本功能并保留原文件，请先按日志修正再重新启动。
    </p>
    <p>
      API 声明为 1.21，按 Java 21 目标编译；隔离服实测为 Purpur 26.1.2-2592 / Java 25。
      具体 Java 要求以所用服务端为准，API 声明不等于所有小版本均已逐一测试。
    </p>


    <h2 id="configuration">新版配置与完整样例</h2>
    <p>每个副本放在 <code>dungeons/副本ID.yml</code>。全局入口生成、性能和体力规则仍在 <code>config.yml</code>；新安装自动生成 iron、gold、diamond 三份新版文件。</p>
    <p>下面可保存为 <code>dungeons/mine.yml</code>。<code>kind: generated</code>表示程序生成地图；自建地图使用<code>kind: template</code>，先用编辑器生成文件，再保留其中的 world 和 markers 信息补充关卡配置。</p>
    <pre><code>{configurationExample}</code></pre>
    <ul>
      <li>房间ID从1连续编号，name是玩家进入该关时屏幕上的Title；最后一间必须<code>boss: true</code>。</li>
      <li>每个waves项是一波，mobs逐行写怪物名和数量，每波最多256只。首领房的waves是前置小怪波，之后自动生成guards和首领。</li>
      <li>首领属性放在<code>boss.attributes</code>，装备和附魔放在<code>boss.equipment</code>；未写的装备保留原版生成装备，明确空手用<code>item: AIR</code>。</li>
      <li>奖励仍为原有共享箱子规则。chance是进入候选池的概率，之后仍参与weight抽取；本版没有改成每人独立发奖。</li>
      <li>同ID新版文件优先于旧文件；<code>enabled: false</code>禁用副本并阻止旧条目重新生效。直接删掉新版文件可能重新读到保留的旧配置。</li>
      <li>错误编号、重复ID、非法数值会阻止整批重载，保留当前有效配置。编辑器发现文件已被外部修改时会拒绝覆盖，请先重载。</li>
    </ul>
    <p>转换备份位于<code>config-backups/时间/</code>，旧文件保留。编辑器奖励箱直接写对应副本文件的rewards，空箱子清空对应奖励池。自建地图的rooms数量须与关卡门划分出的关数一致。</p>
    <p>更多字段与回退步骤见<a href="https://github.com/caicaicat123/nwndungeon/blob/main/CONFIG-V2.md">新版配置手册</a>；默认文件见<a href="https://github.com/caicaicat123/nwndungeon/tree/main/dungeons">三档副本样例</a>。</p>

    <h2 id="mythic">MythicMobs 接入</h2>
    <p>安装可正常运行的MythicMobs 5.x后，波次与护卫可写<code>'MYTHIC:MineGuard': 2</code>，首领type可写<code>'MYTHIC:MineKing'</code>。ID大小写必须一致，生成等级为1。</p>
    <p><strong>神话怪的血量、技能、装备和名称在MythicMobs中配置。</strong>副本不会用boss.attributes或equipment覆盖它；BossBar读取实体真实剩余血量及动态上限。被Mythic原版覆盖规则接管的普通类型，也会让出血量管理，并在首领初始化日志中说明来源。</p>
    <ul>
      <li>实际验证版本为MythicMobs 5.12.1 / Purpur 26.1.2；其他5.x和全部技能包组合未逐一实测。</li>
      <li>支持可战斗原版Mob载体，不支持玩家、盔甲架、展示实体或不能解析为战斗Mob的特殊载体。</li>
      <li>额外召唤物不自动加入清怪名单，跨实体变身不继承旧UUID的首领身份。需要清完的怪请写入waves或guards。</li>
      <li>神话怪失踪先找回原实体；持续失踪会异常结束并退还实扣体力，不重建技能阶段、不直接算通关。</li>
      <li>Mythic自身也开启BossBar时可能显示两条，可在其怪物配置中关闭一条。</li>
    </ul>

    <h2 id="runtime">怪物生成与首领血量</h2>
    <ul>
      <li>到达当前关卡才生成怪物，后面的关卡不会提前刷怪；按实体体型检查落脚点、危险方块和碰撞。</li>
      <li>骷髅等怪物保留原版默认武器，自定义模板装备在原版初始化后覆盖。</li>
      <li>怪物失踪时优先加载实际区块、找回原实体；普通原版怪确认缺失后至少等待 5 秒再有限补刷，每只怪整局最多 3 次。神话怪不重建技能阶段。</li>
      <li>普通怪恢复时保留装备和最近记录的剩余血量，每局每轮最多补刷 2 只；失踪不计击杀、不自动跳波。</li>
      <li>首领必须确认由本局玩家击杀才算胜利；恢复预算耗尽或生成持续失败时结束本局，退还实际扣除的体力，不发通关奖励。</li>
    </ul>
    <h3>首领血量写在哪里？</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead><tr><th>对象</th><th>配置位置</th><th>示例</th></tr></thead>
      <tbody>
        <tr><td>新版内置铁级首领</td><td><code>dungeons/iron.yml</code></td><td><code>boss.attributes.health: 160</code></td></tr>
        <tr><td>新版自建副本首领</td><td><code>dungeons/副本ID.yml</code></td><td><code>boss.attributes.health: 160</code></td></tr>
        <tr><td>神话首领</td><td>MythicMobs怪物定义</td><td><code>Health: 800</code>；副本只读实际血量</td></tr>
        <tr><td>未转换的旧副本</td><td>旧config.yml或dungeons.yml</td><td>仍读取原boss.health路径</td></tr>
        <tr><td>普通怪物模板</td><td><code>mobs.yml</code>中对应模板</td><td><code>health: 40</code></td></tr>
      </tbody>
    </table></div>
    <p>
      血量单位是生命值点数，20 点 = 10 颗心，支持正数与小数。对未被Mythic接管的原版首领，配置160时真实最大血量应为160，
      BossBar 显示当前血量 / 160；受伤、治疗后同步更新。运行中上限被改写时会校正上限并保留剩余血量。
      服务器硬属性上限确实不足时会明确报错，请按错误检查 <code>spigot.yml</code>中的 <code>settings.attribute.maxHealth.max</code>。
    </p>
    <p>
      修改后执行 <code>/nwd reload</code>并重新开局，回显会列出实际配置目录和新首领血量；
      已有及准备中的内置局保留开局难度配置。只有开发权限的账号不会重载全局 <code>config.yml</code>，请使用管理员权限。
    </p>

    <h2 id="performance">准备速度与进入倒计时</h2>
    <p>编辑 <code>config.yml</code>，下面是低配服务器优先的默认值：</p>
    <pre><code>{`trigger:
  cast-seconds: 3                   # 进入前倒计时；0 只取消倒计时

performance:
  max-active-runs: 2                # 内置/自建共享，准备中也占名额
  build-operations-per-tick: 2048   # 内置建造/清理操作数上限
  build-budget-ms: 2                # 达到时间预算后下个 tick 继续`}</code></pre>
    <p>
      「正在准备副本」是实际建造或复制过程，不能直接指定完成秒数。提高操作数和时间预算通常能加快内置副本准备，
      也会增加主线程负担；例如 4096 / 4 ms 比默认预算更高，但不保证耗时减半。准备始终串行，重复按按钮不会重新开局。
      修改后执行 <code>/nwd reload</code>。自建副本的模板复制耗时还受存档大小和磁盘速度影响。
    </p>
    <h3>入口权重如何理解？</h3>
    <p>
      入口保持两次抽选：符合条件的新区块先按 <code>1 / generation.chance</code>决定是否生成入口，默认为 1/400；
      抽中后再按各候选入口的 <code>weight / 总权重</code>选择副本。权重 10 在总权重 100 时占 10%，总权重 110 时占 10/110，
      并非固定 10%。自建副本开启随机入口后也会参与权重池。
    </p>

    <h2 id="what">这是什么</h2>
    <p>
      自1.5.0起，插件的定位是<strong>在原有内置副本之外，增加一套「管理员自建副本」体系</strong>，而不是替换内置副本。
      两套入口共用同一棵命令树，互不影响。
    </p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>对比项</th><th>内置副本</th><th>自建副本（1.5.0 新增）</th></tr>
      </thead>
      <tbody>
        <tr><td>由谁生成</td><td>插件程序按 iron / gold / diamond 三档生成</td><td>管理员在游戏内搭建</td></tr>
        <tr><td>地形</td><td>程序按槽位生成</td><td>自建的模板世界，一局一个独立世界</td></tr>
        <tr><td>入口</td><td>自然生成的遗迹</td><td>自建的门楼，或由命令贴出</td></tr>
        <tr><td>命令</td><td><code>/dungeon ...</code></td><td>同一棵命令树（见下）</td></tr>
      </tbody>
    </table></div>

    <h3>一局一个世界</h3>
    <p>
      开局时，插件把模板文件夹<strong>复制</strong>成 <code>nwndinst_&lt;slug&gt;_&lt;序号&gt;</code> 并加载，
      结束时卸载并删除。因此同时开几局就会同时加载几个世界。
      <code>config.yml</code>中的<code>performance.max-active-runs</code>是内置与自建副本共享的全局并发上限，准备中的局也计入。
    </p>

    <h2 id="commands">命令与权限</h2>

    <h3>三个命令名等价</h3>
    <pre><code>/dungeon  =  /nwd  =  /nwmdungeon</code></pre>
    <p>
      只有一个根命令，按子命令名分发。<code>test</code>、<code>spawn</code>、<code>list</code> 等子命令两边同名，
      因此按参数判断走哪一套：后面接内置难度名（<code>iron</code> / <code>gold</code> / <code>diamond</code>）走内置副本，
      否则当作自建副本的名字。
    </p>

    <h3>权限节点</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>节点</th><th>默认</th><th>可执行的命令</th></tr>
      </thead>
      <tbody>
        <tr><td><code>nwd.use</code></td><td>所有人</td><td>使用副本入口，<code>leave</code> / <code>locate</code> / <code>stamina</code></td></tr>
        <tr><td><code>nwd.admin</code></td><td>op</td><td><code>spawn &lt;难度&gt;</code>、<code>test &lt;难度&gt;</code>、<code>list</code>、<code>tp</code>、<code>release</code>、<code>reload</code></td></tr>
        <tr><td><code>nwd.dev</code></td><td>op</td><td>自建副本创作工具：<code>edit</code>、<code>new ...</code>、<code>test &lt;副本名&gt;</code>、<code>end</code>、<code>doctor</code> 等</td></tr>
      </tbody>
    </table></div>
    <p>
      旧的 <code>nwndungeon.use</code> / <code>nwndungeon.admin</code> / <code>nwndungeon.dev</code>
      同样声明，代码里两套都认，已经发到玩家手上的权限组不需要改。
    </p>

    <h3>玩家命令</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>命令</th><th>说明</th></tr>
      </thead>
      <tbody>
        <tr><td><code>/dungeon leave</code></td><td>离开当前副本，回到进本前的位置。副本内禁用其它命令，这条始终可用</td></tr>
        <tr><td><code>/dungeon stamina</code></td><td>查看自己的体力（即每日可进入的次数）</td></tr>
        <tr><td><code>/dungeon locate [难度|any]</code></td><td>查找离你最近的副本入口，给出方向与坐标；不写难度即不限</td></tr>
      </tbody>
    </table></div>

    <h3>管理员命令</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>命令</th><th>说明</th></tr>
      </thead>
      <tbody>
        <tr><td><code>/dungeon spawn &lt;难度&gt; [x y z [世界]]</code></td><td>在指定位置生成一座副本入口；不写坐标即在你面前。难度为 iron / gold / diamond</td></tr>
        <tr><td><code>/dungeon test &lt;难度&gt;</code></td><td>生成一个内置副本槽位用于自测，打完自动释放</td></tr>
        <tr><td><code>/dungeon list</code></td><td>查看内置副本的槽位占用情况</td></tr>
        <tr><td><code>/dungeon tp &lt;槽位号&gt;</code></td><td>传送到指定槽位；槽位空着也能进，会送到它的原点</td></tr>
        <tr><td><code>/dungeon release &lt;槽位号|all&gt;</code></td><td>强制回收槽位，里面的人会被送回入口</td></tr>
        <tr><td><code>/nwd migrate</code></td><td>管理员备份并转换旧配置到dungeons目录，不覆盖已有新版文件</td></tr>
        <tr><td><code>/dungeon reload</code></td><td>管理员重载全局配置和自建副本登记；先校验全部候选配置，成功后替换生效</td></tr>
      </tbody>
    </table></div>

    <h3>创作命令（<code>nwd.dev</code>）</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>命令</th><th>说明</th></tr>
      </thead>
      <tbody>
        <tr><td><code>/nwd edit</code></td><td>打开编辑器面板：不在编辑态时是副本列表，在编辑态里是标记面板</td></tr>
        <tr><td><code>/nwd new world create &lt;名字&gt; [void|flat|normal]</code></td><td>新建模板世界并进入编辑态（创造 + 飞行）。名字最多 24 字、不能含点号；生成器默认 void</td></tr>
        <tr><td><code>/nwd new world save</code></td><td>保存当前模板：落盘、卸载、把编辑世界搬成模板；旧模板自动备份</td></tr>
        <tr><td><code>/nwd new start</code></td><td>把「进本落点」记在脚下；未标则使用世界出生点</td></tr>
        <tr><td><code>/nwd new stage &lt;关卡号&gt;</code></td><td>切换「当前关卡」，之后的刷怪点记到该关；不写即第 1 关</td></tr>
        <tr><td><code>/nwd new wave &lt;波次号&gt;</code></td><td>切换「当前波次」</td></tr>
        <tr><td><code>/nwd new spawner &lt;波次号&gt;</code></td><td>把脚下记成当前关卡第 N 波的刷怪点；不写波次即用面板里当前选择的。刷什么怪写在对应副本文件的rooms中</td></tr>
        <tr><td><code>/nwd new gate [remove]</code></td><td>看着一扇门登记关卡门；<code>remove</code> 为删除看着的那道</td></tr>
        <tr><td><code>/nwd new exit [remove]</code></td><td>看着一扇门登记出口门；<code>remove</code> 为清掉</td></tr>
        <tr><td><code>/nwd new boss</code></td><td>记下首领登场的位置；属性写在 副本文件的<code>boss.attributes</code>与<code>boss.equipment</code></td></tr>
        <tr><td><code>/nwd new checkpoint</code></td><td>把脚下记成检查点，同时记录脚下 3×3 方块的签名</td></tr>
        <tr><td><code>/nwd new reward [supply|reward]</code></td><td>看着一个箱子执行，记录位置并打开箱子界面放置物品，关闭界面即保存到对应副本文件的rewards（旧格式写loot.yml）</td></tr>
        <tr><td><code>/nwd new undo</code></td><td>撤销最近打的一个标记（刷怪点 / 检查点 / 箱子）</td></tr>
        <tr><td><code>/nwd new list</code></td><td>查看当前标了多少、分了几关</td></tr>
        <tr><td><code>/nwd new door</code></td><td>搭入口时登记哪一格是门（材质照原样记录）</td></tr>
        <tr><td><code>/nwd new trigger</code></td><td>搭入口时登记触发点；按钮、压力板、拉杆都可用</td></tr>
        <tr><td><code>/nwd new entrance create &lt;副本名&gt;</code> / <code>save</code> / <code>cancel</code></td><td>进入入口搭建世界 / 保存入口结构 / 放弃本次搭建</td></tr>
        <tr><td><code>/nwd list</code></td><td>列出所有自建副本（名字、世界名、模板体积、落点是否已标）</td></tr>
        <tr><td><code>/nwd test &lt;名字&gt;</code></td><td>立刻开一局自建副本自测</td></tr>
        <tr><td><code>/nwd spawn &lt;名字&gt;</code></td><td>在你面前贴一座该副本的入口</td></tr>
        <tr><td><code>/nwd end [名字]</code></td><td>结束正在跑的自建副本；不写名字即结束全部</td></tr>
        <tr><td><code>/nwd delete &lt;名字&gt;</code></td><td>删除一个自建副本；模板文件夹会挪进 <code>templates/_deleted/</code> 保留退路</td></tr>
        <tr><td><code>/nwd doctor</code></td><td>自检：建临时世界 → 放标记方块 → 保存 → 复制成新世界 → 检查方块是否还在 → 清理</td></tr>
        <tr><td><code>/nwd reload</code></td><td>三个命令名行为一致；仅有开发权限时重载自建副本文件及registry.yml，不重载全局设置；管理员可重载全部配置</td></tr>
        <tr><td><code>/nwd help [页码|子命令]</code></td><td>查看帮助；<code>/nwd help new world create</code> 可查单条</td></tr>
      </tbody>
    </table></div>
    <p class="callout">
      <strong>以游戏内帮助为准。</strong>帮助文本由插件的命令登记表生成，不会与实现漂移；
      本文的表格是同一份内容的整理版。用 <code>/nwd help &lt;子命令&gt;</code> 可以查单条命令的参数、权限、示例与易错点。
    </p>

    <h2 id="quickstart">快速上手</h2>
    <pre><code>① /nwd edit                      → 打开副本列表面板
② 点「新建副本」→ 在聊天里输入名字   → 进入虚空搭建世界（创造模式 + 飞行 + 自动发编辑时钟）
③ 搭房间、放门、放箱子
④ /nwd edit（或右键编辑时钟）      → 打开标记面板
⑤ 依次标记：落点 → 刷怪点（选波次）→ 关卡门（看着门）→ 检查点 → 首领位 → 出口门（看着门）
⑥ 点「保存」                      → 落盘并搬成模板
⑦ /nwd test &lt;名字&gt;               → 自己进去打一局</code></pre>

    <h3>编辑时钟</h3>
    <p>
      进入编辑态或入口搭建态时，插件会自动发一个时钟到快捷栏第一个空位，
      <strong>右键即可打开对应面板</strong>，保存或放弃后自动收回。因此不必反复输入命令。
    </p>

    <h2 id="panels">四个面板</h2>

    <h3>面板 A · 副本列表（<code>/nwd edit</code>）</h3>
    <p>
      界面大小按内容决定：没有副本时 9 格一行；不超过 18 个副本时 27 格；更多时用 45 或 54 格。
      按钮居中排在最后一行：新建副本 · 新建入口建筑 · 这套怎么用 · 关闭。
    </p>
    <ul>
      <li><strong>左键</strong>副本图标 = 进入编辑</li>
      <li><strong>右键</strong>副本图标 = 删除（二次确认，模板挪进 <code>_deleted/</code>）</li>
    </ul>

    <h3>面板 B · 标记面板（编辑态下的 <code>/nwd edit</code>）</h3>
    <p>一行一个主题，其余格子用黑玻璃板填满：</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>行</th><th>图标（槽位号）</th></tr>
      </thead>
      <tbody>
        <tr><td>位置</td><td>落点(1) · 首领位(3) · 传送到落点(5) · 传送到首领位(7)</td></tr>
        <tr><td>关卡与波次</td><td>关卡◀(10) 第 N 关(11) 关卡▶(12) · 波次◀(14) 第 N 波(15) 波次▶(16)</td></tr>
        <tr><td>点位与箱子</td><td>刷怪点(19) 检查点(20) 清本波(21) · 补给箱(23) 奖励箱(24) 撤销(26)</td></tr>
        <tr><td>门</td><td>关卡门(28) 删除关卡门(30) · 出口门(32) 删除出口门(34)</td></tr>
        <tr><td>状态与辅助</td><td>标记清单(37) 校验(39) 这个世界(41) 标记提示(43) 删除这个副本(44)</td></tr>
        <tr><td>操作</td><td>清空全部标记(45) 保存(46) 放弃(48) 返回列表(50) 说明(52) 关闭(53)</td></tr>
      </tbody>
    </table></div>
    <ul>
      <li>标注「看着一扇门」的图标（关卡门、出口门、删除门），需要先用准星看着目标再点击</li>
      <li>关卡门：左键登记，<strong>右键删除</strong>你看着的那一道</li>
      <li>「删除这个副本」有二次确认；如果你正站在它的编辑世界里，会先按「放弃」把你送回主世界再删除</li>
    </ul>

    <h3>面板 C · 入口搭建（<code>/nwd new entrance create</code>）</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>槽位</th><th>图标</th></tr>
      </thead>
      <tbody>
        <tr><td>10</td><td>入口门（看着门点击）</td></tr>
        <tr><td>12</td><td>触发点（看着按钮 / 压力板 / 拉杆点击）</td></tr>
        <tr><td>14</td><td>保存入口（自动框选范围 → 存为结构 → 离开）</td></tr>
        <tr><td>16</td><td>放弃（删除本次搭建世界，已保存的结构不受影响）</td></tr>
        <tr><td>22</td><td>提示</td></tr>
        <tr><td>24</td><td>删除这份入口结构（二次确认，删除对应的 <code>.nbt</code>）</td></tr>
      </tbody>
    </table></div>

    <h3>面板 D · 说明页（「这套怎么用」）</h3>
    <p>27 格界面：返回(19) · 关闭(23)。「返回」会按你从哪个面板进入而回到对应面板。</p>

    <h2 id="markers">标记的语义与规则</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>标记</th><th>含义</th><th>规则</th></tr>
      </thead>
      <tbody>
        <tr><td>落点</td><td>进本后玩家出现的位置</td><td>未标则使用世界出生点</td></tr>
        <tr><td>关卡门</td><td>本关的出口，清完场才会开启</td><td><strong>关卡数 = 关卡门数 + 1</strong>，最后一关是首领区</td></tr>
        <tr><td>刷怪点</td><td>某一关某一波的刷怪位置</td><td>用 ◀▶ 选择关卡与波次；刷什么怪写在对应副本文件的rooms中 的 <code>stages[].waves</code></td></tr>
        <tr><td>检查点</td><td>死亡后的复活位置</td><td>记录坐标与脚下 3×3 方块签名；方块被拆则该检查点失效，照原样补回即恢复</td></tr>
        <tr><td>首领位</td><td>首领登场的位置</td><td>属性写在 副本文件的<code>boss.attributes</code>与<code>boss.equipment</code>；首领必须确认击杀，原版首领最多在标记处补刷3次；神话首领只找回，不重建阶段</td></tr>
        <tr><td>出口门</td><td>通关后右键它离开副本</td><td>未标则在首领位放一扇默认木门兜底</td></tr>
        <tr><td>补给箱</td><td>打怪途中的补给</td><td>看着箱子执行，在弹出的箱子界面中放置物品，关闭界面即保存到对应副本文件的rewards（旧格式写loot.yml）</td></tr>
        <tr><td>奖励箱</td><td>通关奖励</td><td>同上</td></tr>
      </tbody>
    </table></div>

    <h3>五条关键规则</h3>
    <ol>
      <li><strong>同一扇门不能既是关卡门又是出口门</strong>，两边都会拒绝并提示如何修改。</li>
      <li><strong>删除关卡门会自动重排关卡</strong>：删掉第 i 道门后，原第 i 关与第 i+1 关合并，后续关卡的刷怪点与补给箱会自动前移一位（不前移就会挂到错误的关卡上）。</li>
      <li><strong>门不记录材质</strong>：放的是什么门就存什么门，木门、铜门、铁门均可，命令里没有材质参数。</li>
      <li><strong>未清场时关卡门打不开</strong>：插件每 5 tick 强制关门，同时取消右键与门附近 3 格内的压力板 / 按钮。</li>
      <li>「标记清单」会把所有标记逐条输出到聊天栏，「校验」会挑出缺失或失效的项。</li>
    </ol>

    <h2 id="entrance">入口建筑</h2>

    <h3>流程</h3>
    <pre><code>/nwd new entrance create &lt;副本名&gt;     → 进入虚空搭建世界
   搭一座门楼（放一扇门 + 一个按钮或压力板）
   在面板中点击「入口门」（看着门）→ 点击「触发点」（看着按钮）
   点击「保存入口」                     → 自动框选范围并保存为结构
/nwd spawn &lt;名字&gt;                   → 在你面前贴出一座，门与触发点一并登记好</code></pre>

    <h3>实测行为</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>行为</th><th>说明</th></tr>
      </thead>
      <tbody>
        <tr><td>结构粘贴不带门</td><td>当前服务端版本的结构粘贴不会带上门方块，插件会按记录的材质、朝向与铰链自行补摆回去</td></tr>
        <tr><td>结构粘贴不带箱子内的物品</td><td>贴出来是空箱子。因此<strong>不要在入口结构的箱子里放东西</strong>，奖励与补给请用标记配合副本文件的rewards</td></tr>
        <tr><td>入口登记写在区块数据里</td><td>门是普通方块、无法存 NBT，因此记录挂在区块的持久化数据上</td></tr>
        <tr><td>打掉那扇门 = 该入口永久失效</td><td>登记项会被标记为失效，踩踏或按压都不再传送；记录仍保留在 <code>entrances.yml</code> 中</td></tr>
      </tbody>
    </table></div>

    <h3>删除入口</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>目标</th><th>做法</th></tr>
      </thead>
      <tbody>
        <tr><td>让一个入口失效</td><td>把那扇门打掉</td></tr>
        <tr><td>删除已保存的入口结构（重建一份干净的）</td><td>入口面板 → 「删除这份入口结构」，或手动删除 <code>templates/entrances/&lt;slug&gt;.nbt</code> 与同名 <code>.yml</code></td></tr>
        <tr><td>删除入口登记记录</td><td>目前没有对应命令，需要手动编辑 <code>entrances.yml</code></td></tr>
      </tbody>
    </table></div>
    <p class="callout">
      <strong>已知问题：重复搭建会让入口越存越多。</strong>
      重新进入入口搭建世界时，插件会把上次保存的入口贴回来供你修改。如果你在它旁边又搭了一座，
      保存时自动框选会把两座一起框进去，之后每次 <code>/nwd spawn</code> 都会贴出两座。
      处理办法：在入口面板点「删除这份入口结构」，再重新 <code>new entrance create</code> 搭一座并保存。
    </p>

    <h2 id="files">数据与文件</h2>
    <pre><code>plugins/NWNDungeon/
├── config.yml            全局配置：规则、槽位、体力、触发、生成、世界名单
├── dungeons/             新版：一个副本一个YAML（关卡、首领、奖励）
├── config-backups/       转换前备份
├── dungeons.yml          旧格式兼容登记
├── registry.yml          副本名 → 世界 slug 的映射
├── loot.yml              旧奖励池兼容来源；新版可在各副本文件配置
├── mobs.yml              怪物模板
├── party.yml             组队相关
├── entrances.yml         世界入口登记（world / x / y / z / tier / alive / created）
├── pending-delete.txt    待删除清单（文件句柄释放后于下次启动删除）
├── stamina-refunds.yml   离线体力退款记录
├── diagnostics/
│   ├── failures.log          异常与恢复记录（含原因/堆栈）
│   ├── failures.previous.log 上一份诊断日志（约1MB后轮转）
│   └── boss-health.log       可选出生血量追踪（默认关闭）
└── templates/
    ├── worlds/&lt;slug&gt;/                    模板世界（平时不加载）
    ├── entrances/&lt;slug&gt;.nbt + .yml       入口结构
    ├── _recovered/                       临时世界（重启时保存在里面的人的改动）
    ├── _deleted/                         已删除的副本模板（保留退路）
    └── _backup/                          被覆盖的旧模板（保存时自动备份）</code></pre>

    <h3>世界维度</h3>
    <p>编辑与运行过程中的世界都以独立维度存在，命名如下：</p>
    <ul>
      <li><code>nwndtpl_&lt;slug&gt;</code> —— 正在编辑的临时模板世界</li>
      <li><code>nwndinst_&lt;slug&gt;_&lt;n&gt;</code> —— 正在运行的副本实例，结束后删除</li>
      <li><code>nwndent_&lt;slug&gt;</code> —— 入口搭建世界</li>
    </ul>
    <p>
      当前的存档布局中，所有维度都在同一个存档里（<code>world/dimensions/minecraft/&lt;名字&gt;/</code>），
      因此「复制一个世界」等于复制一个维度文件夹，通常不到 1 MB。维度名必须为 ASCII，
      中文名只用于界面显示。
    </p>

    <h2 id="limits">已知限制与注意事项</h2>
    <p>
      本版已提供一个副本一个YAML、数字房间ID、关卡Title和首领属性装备分区；奖励继续沿用共享箱子规则。
      以下边界需要服主了解：
    </p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>现象</th><th>原因与处理</th></tr>
      </thead>
      <tbody>
        <tr><td>记录检查点后又破坏该位置</td><td>自建副本复活时尚未重新核验已记录检查点的签名与安全落脚点；运行中请保留检查点平台</td></tr>
        <tr><td>玩家离线时副本结束或服务器重启</td><td>进本前位置、模式与飞行状态的跨重启恢复尚未完整持久化；自建副本离线结束场景仍需完善</td></tr>
        <tr><td>不同插件组合或大量并发</td><td>长时间压力与全部第三方插件组合未完整验证；先在自己的测试环境验证，再按负载调整并发与预算</td></tr>
        <tr>
          <td>保存模板时报错，提示搬成模板失败</td>
          <td>卸载世界后文件句柄尚未释放，重命名会失败。插件已改为「重命名失败则递归复制，并把源目录记入待删清单，下次启动清理」</td>
        </tr>
        <tr>
          <td>进入服务器后出现在地底</td>
          <td>原因为虚空世界的落点过低（位于世界底部附近）叠加服务器重启。新建的虚空世界落点已抬高，且重启前会把仍在编辑器中的人送回主世界。自救方式：<code>/tp @s 0 120 0</code></td>
        </tr>
        <tr>
          <td>结构里存了两座入口</td>
          <td>见「入口建筑」一节的已知问题，用「删除这份入口结构」重建</td>
        </tr>
        <tr>
          <td>人在编辑世界时服务器重启</td>
          <td>该世界会被完整保留到 <code>templates/_recovered/</code>，数据不会丢失；目前没有界面可以恢复，需要手动把文件夹移回 <code>templates/worlds/&lt;slug&gt;/</code></td>
        </tr>
        <tr>
          <td>开本后门推不开</td>
          <td>正常行为：本关未清完时门是锁定的</td>
        </tr>
        <tr>
          <td>怪物刷到了别的关卡</td>
          <td>通常是删除关卡门后没有重排；现已自动重排。若仍出现，请记录关卡号上报</td>
        </tr>
        <tr>
          <td>保存后的模板体积异常大</td>
          <td>自动框选把多余的东西也框了进去（例如两座入口建筑）。用「删除这份入口结构」重建后再保存</td>
        </tr>
      </tbody>
    </table></div>

    <h2 id="faq">常见问题</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>
      <thead>
        <tr><th>问题</th><th>回答</th></tr>
      </thead>
      <tbody>
        <tr><td>仍出现副本异常退出，控制台却没找到原因？</td><td>查看 <code>plugins/NWNDungeon/diagnostics/failures.log</code>及上一份轮转日志。反馈时附版本、报错前后日志和配置片段，不要只贴“异常退出”的聊天提示</td></tr>
        <tr><td>首领显示60或277/800，与配置不同？</td><td>先确认已完整重启加载1.5.1并新开一局；检查是否被Mythic接管。神话怪请改Mythic的Health，原版首领改副本文件的boss.attributes.health。需区分出生血量与真实受伤，可开启config.yml的diagnostics.boss-health-trace，查看boss-health.log</td></tr>
        <tr><td>改旧文件却不生效？</td><td>同ID新版文件优先；请编辑dungeons目录中的对应YAML。/nwd migrate不会覆盖已有新版文件</td></tr>
        <tr>
          <td><code>/dungeon edit</code> 提示已退役？</td>
          <td>正常。早期的半成品编辑器已被 <code>/nwd edit</code> 取代</td>
        </tr>
        <tr>
          <td>原来的 <code>/dungeon</code> 还能用吗？</td>
          <td>能用。内置副本（iron / gold / diamond）保留不变，自建副本是新增的一套</td>
        </tr>
        <tr>
          <td>执行 <code>/nwd spawn A</code> 后出现两座建筑</td>
          <td>保存的入口结构里包含不止一座，用「删除这份入口结构」重建</td>
        </tr>
        <tr>
          <td>自建副本能给玩家用吗？</td>
          <td>可以。玩家通过入口进入，与内置副本共用体力、结算等规则</td>
        </tr>
      </tbody>
    </table></div>
