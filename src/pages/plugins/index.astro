---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PluginCard from '../../components/PluginCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Faq from '../../components/Faq.astro';
import { pluginFaqs, pluginRequirements, plugins, pluginsSummary, serverPluginCategories } from '../../data/plugins';
import { site } from '../../data/site';

const description =
  '新世界网络（NWN）自研的《我的世界》服务端插件：随机副本（NWNDungeon）与幽灵（TheGhost）。可直接下载 jar，Paper / Purpur 1.21+ 可用，MIT 开源；含部署条件、开源许可与常见问题。';
---

<BaseLayout title="MC插件" description={description}>
  <!--
    冗余原则（2026-10-04 用户要求）：本页原先在首屏放了一张「插件速查」表，
    但它与下方的插件卡片（名称 / 版本 / 适用服务端）、部署条件一节、开源许可一节
    逐条重复 —— 已整块删除。**插件页的事实出处就是卡片本身**：
    名称、标识、版本、适用服务端、下载链接都在卡片上，不再另列表格。
  -->
  <section class="site-hero site-hero--plugins border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="section-label">自研插件</p>
      <h1 class="text-2xl font-semibold text-strong sm:text-3xl">MC插件</h1>
      <p class="mt-4 max-w-3xl text-base leading-[1.85] text-muted">{pluginsSummary}</p>
    </div>
  </section>

  <!-- 有哪些插件 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="可下载插件"
      title="有哪些插件可以下载？"
      desc="以下两个插件均由本工作室开发，并在自营服务器上实际运行；本页只讲「怎么拿到、怎么装」，具体玩法见服务器页。"
      descAs="p"
    />
    <div class="grid gap-5 md:grid-cols-2">
      {
        plugins.map((plugin) => (
          <PluginCard
            name={plugin.name}
            tag={plugin.tag}
            version={plugin.version}
            platform={plugin.platform}
            status={plugin.status}
            desc={plugin.desc}
            releaseNote={'releaseNote' in plugin ? plugin.releaseNote : undefined}
            download={plugin.download}
            beta={'beta' in plugin ? plugin.beta : undefined}
          />
        ))
      }
    </div>
  </section>

  <!-- 安装要求 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="部署条件"
        title="部署这两个插件需要什么条件？"
        desc="两个插件均要求 Paper 或 Purpur 1.21 及以上、JDK 21 及以上的服务端；将 jar 放入 plugins/ 目录后重启服务器即可完成安装。"
        descAs="p"
      />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pluginRequirements.filter((item) => !item.startsWith('许可：')).map((item) => (
            <li class="card p-5 text-base leading-relaxed text-ink">{item}</li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
        两个插件均不需要额外的前置插件。幽灵未配置 API Key 时使用本地台词；如需模型生成回复，请自行配置服务商和 API Key，调用费用以所选平台规则为准。
      </p>
    </div>
  </section>

  <!-- 服务器上还在用什么插件 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <!--
      本页保留这一节的理由：它回答的是「下载来源」问题（在插件页），
      而服务器页只列插件清单、不讲仓库与 Release。两边不重复。
    -->
    <SectionHeading
      eyebrow="服务器在用插件"
      title="我们的服务器装了哪些插件？"
      desc="除上述两个自研插件外，服务器还部署了约 30 个第三方插件，按用途分为四类：保护与回滚、经济与交易、成长与奖励、体验与兼容。"
      descAs="p"
    />
    <div class="grid gap-5 md:grid-cols-2">
      {
        serverPluginCategories.map((category) => (
          <article class="card p-6">
            <h3 class="text-base font-semibold text-strong">{category.title}</h3>
            <p class="mt-3 text-base leading-[1.85] text-muted">{category.desc}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
      这些插件对应的玩法说明与上手步骤，见
      <a href="/minecraft/" class="text-primary underline decoration-1 underline-offset-4 transition-opacity hover:opacity-80">服务器页</a>。
    </p>
  </section>

  <!-- 文档 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="文档"
      title="有使用文档吗？"
      desc="与管理相关的功能另有逐节说明的文档：命令、面板、标记规则与已知限制。"
      descAs="p"
    />
    <div class="grid gap-5 md:grid-cols-2">
      <a href="/plugins/dungeon/" class="card card-interactive flex flex-col p-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge label-latin">NWNDungeon</span>
          <span class="badge badge-primary">1.5.0 · 预览版</span>
        </div>
        <h3 class="mt-3 text-base font-semibold text-strong">管理员自建副本文档</h3>
        <p class="mt-2 flex-1 text-base leading-[1.85] text-muted">
          由管理员在游戏内搭建副本模板：命令与权限、四个编辑面板、标记的语义与规则、
          入口建筑的实测行为、数据文件位置与已知限制。
        </p>
        <span class="mt-4 text-sm text-primary underline decoration-1 underline-offset-4">阅读文档</span>
      </a>
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
      自建副本功能目前仅在 1.5.0 测试版提供，正式版暂不包含这部分功能。
    </p>
  </section>

  <!-- 开源 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="开源许可"
        title="这些插件开源吗？"
        desc="两个插件均按 MIT 许可公开，允许自由使用、修改与二次开发，亦可用于商业用途，仅需保留版权声明。"
        descAs="p"
      />
      <div class="card p-6">
        <p class="text-base leading-[1.85] text-muted">
          插件源码、指令表、权限节点与更新记录均可在对应的 GitHub 仓库查看。
          如遇问题，可在 GitHub 提交 Issue，或通过 QQ 群反馈。
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
            访问 GitHub
          </a>
          <a href="/mod/" class="btn btn-standard">查看 Mod 计划</a>
          <a href="/minecraft/" class="btn btn-subtle">服务器详情</a>
        </div>
      </div>
    </div>
  </section>

  <Faq
    eyebrow="其他问题"
    title="还有哪些常见问题？"
    desc="了解插件授权、版本更新与使用文档。"
    items={pluginFaqs}
  />
</BaseLayout>
