---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServerStatus from '../components/ServerStatus.astro';
import BlogCard from '../components/BlogCard.astro';
import { site } from '../data/site';
import { formatDate } from '../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={site.name}>
  <!-- Hero：两个方向做成可横向滚动的页面 -->
  <HeroCarousel />

  <!-- 服务器状态 -->
  <section id="server-status" class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="服务器状态"
        title="服务器状态"
        desc="服务器长期开放，地址与版本等完整信息见服务器页速查表。"
      />
      <a href="/minecraft/" class="mb-14 text-sm text-primary underline decoration-1 underline-offset-4 transition-opacity hover:opacity-80">
        服务器详情
      </a>
    </div>
    <!--
      首页状态卡用 mini 档：只给「在线 / 人数」。
      版本号、客户端范围、离线模式这些事实**不在这里复述** ——
      它们的主场是服务器页速查表（2026-10-04 冗余清理，原先还写了「Java 版 26.1.2，全版本可进，离线模式」）。
    -->
    <ServerStatus mini />
  </section>

  <!-- 最新文章 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="博客" title="最新文章" />
      <a href="/blog/" class="mb-8 text-sm text-primary underline decoration-1 underline-offset-4 transition-opacity hover:opacity-80">
        全部文章
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
    {
      posts.length === 0 && <p class="card p-5 text-sm text-muted">还没有文章，第一篇正在写。</p>
    }
    </div>
  </section>

</BaseLayout>
