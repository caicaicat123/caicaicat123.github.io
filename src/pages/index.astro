---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServerStatus from '../components/ServerStatus.astro';
import BlogCard from '../components/BlogCard.astro';
import RoadmapItem from '../components/RoadmapItem.astro';
import { site } from '../data/site';
import { roadmap } from '../data/roadmap';
import { formatDate } from '../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const matrix = [
  {
    tag: 'GAME',
    title: 'Minecraft 服务器',
    desc: '长期运营的《我的世界》服务器，是社区入口，也是 AI 实验的真实场地。',
    href: '/minecraft',
    cta: '服务器信息',
  },
  {
    tag: 'AI',
    title: 'AI 实验室',
    desc: '稷下 Jixia：聚焦哲学、心理学、经济学的人文社科模型，为世界政治经济提供预测指南。',
    href: '/ai-lab',
    cta: '查看实验方向',
  },
  {
    tag: 'OPEN',
    title: '开源与归档',
    desc: '代码、数据与评测方法尽量开源，实验日志长期留存，接受外部检验。',
    href: '/projects',
    cta: '浏览项目',
  },
];

const previewRoadmap = roadmap.slice(0, 3);
---

<BaseLayout title={site.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="pixel-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div class="glow-primary absolute -right-16 -top-24 h-80 w-80" aria-hidden="true"></div>
    <div class="glow-secondary absolute -bottom-32 left-0 h-80 w-80" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:py-28">
      <div class="fade-up max-w-3xl">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <span class="badge badge-primary font-pixel">{site.nameEn}</span>
          <span class="badge">人工智能 × 游戏开发</span>
        </div>

        <h1 class="text-3xl font-semibold leading-tight tracking-tight text-strong sm:text-5xl">
          在百家争鸣中，<br class="hidden sm:block" />推演世界的走向。
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {site.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/minecraft"
            class="rounded-md border border-primary/40 bg-primary/10 px-5 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-primary/20"
          >
            进入服务器
          </a>
          <a
            href="/ai-lab"
            class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-secondary/50 hover:text-secondary"
          >
            了解 AI 实验室
          </a>
        </div>

        <p class="mt-8 font-pixel text-xs text-muted">
          {site.vision}
        </p>
      </div>
    </div>
  </section>

  <!-- 服务器状态 -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading
      eyebrow="SERVER"
      title="服务器状态"
      desc="Java 版 26.1.2，1.7 至 26.1 全版本可进，离线模式。下面是实时状态查询。"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <ServerStatus />
      <div class="card flex flex-col justify-between p-5">
        <div>
          <p class="text-sm font-medium text-ink">加入之前</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            服务器是离线模式，进服后要先用登录插件注册账号。规则与教程都在 Minecraft 页面。
          </p>
        </div>
        <a href="/minecraft" class="mt-4 text-sm text-primary transition-opacity hover:opacity-80">
          查看规则与教程 →
        </a>
      </div>
      <div class="card flex flex-col justify-between p-5">
        <div>
          <p class="text-sm font-medium text-ink">社区与版本</p>
          <dl class="mt-3 space-y-1.5 text-xs text-muted">
            <div class="flex justify-between gap-3">
              <dt>客户端</dt>
              <dd class="text-ink">Java 版</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt>开服时间</dt>
              <dd class="text-ink">2024 年至今</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt>QQ 群</dt>
              <dd class="font-mono text-ink">{site.community.qq}</dd>
            </div>
          </dl>
        </div>
        <a href="/contact" class="mt-4 text-sm text-primary transition-opacity hover:opacity-80">
          加入社区 →
        </a>
      </div>
    </div>
  </section>

  <!-- 业务矩阵 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <SectionHeading
        eyebrow="WHAT WE DO"
        title="我们在做什么"
        desc="一条主线两条支线：把游戏服务器运营好，同时用它来验证 AI 的想法。"
      />
      <div class="grid gap-5 md:grid-cols-3">
        {
          matrix.map((item) => (
            <a href={item.href} class="card group flex h-full flex-col p-5">
              <span class="badge badge-primary font-pixel mb-3 self-start">{item.tag}</span>
              <h3 class="text-base font-semibold text-strong">{item.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{item.desc}</p>
              <span class="mt-4 text-sm text-primary transition-transform group-hover:translate-x-0.5">
                {item.cta} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 最新日志 -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="LOG" title="最新技术日志" />
      <a href="/blog" class="mb-8 text-sm text-primary transition-opacity hover:opacity-80">
        全部日志 →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
    {
      posts.length === 0 && (
        <p class="card p-5 text-sm text-muted">还没有日志，第一篇正在写。</p>
      )
    }
  </section>

  <!-- 路线图预览 -->
  <section class="border-t border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="ROADMAP" title="路线图" />
        <a href="/roadmap" class="mb-8 text-sm text-primary transition-opacity hover:opacity-80">
          完整路线图 →
        </a>
      </div>
      <div class="grid gap-x-10 md:grid-cols-3">
        {
          previewRoadmap.map((item) => (
            <RoadmapItem
              phase={item.phase}
              period={item.period}
              title={item.title}
              status={item.status}
              items={item.items}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="pixel-grid card relative overflow-hidden p-8 sm:p-10">
      <div class="glow-primary absolute -right-10 -top-10 h-56 w-56" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-xl font-semibold text-strong sm:text-2xl">一起来把这个世界做大</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          无论你是想进来盖房子、写代码，还是想一起训模型，都欢迎先来社区看看。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="rounded-md border border-primary/40 bg-primary/10 px-5 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-primary/20"
          >
            联系我们
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-secondary/50 hover:text-secondary"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
