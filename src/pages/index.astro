---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServerStatus from '../components/ServerStatus.astro';
import BlogCard from '../components/BlogCard.astro';
import { site } from '../data/site';
import { formatDate } from '../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={site.name}>
  <!-- Hero：两个方向做成可横向滚动的页面 -->
  <HeroCarousel />

  <!-- 服务器状态 -->
  <section id="server-status" class="mx-auto max-w-6xl px-4 py-20">
    <SectionHeading
      eyebrow="SERVER"
      title="服务器状态"
      desc="Java 版 26.1.2，1.7 至 26.1 全版本可进，离线模式。下面是实时状态查询。"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <ServerStatus />
      <div class="card flex flex-col justify-between p-5">
        <div>
          <p class="text-sm font-medium text-ink">加入之前</p>
          <p class="mt-2 text-base leading-relaxed text-muted">
            服务器是离线模式，进服后要先用登录插件注册账号。规则与教程都在 Minecraft 页面。
          </p>
        </div>
        <a href="/minecraft" class="mt-4 text-sm text-primary transition-opacity hover:opacity-80">
          查看规则与教程 →
        </a>
      </div>
      <div class="card flex flex-col justify-between p-5">
        <div>
          <p class="text-sm font-medium text-ink">社区与版本</p>
          <dl class="mt-3 space-y-1.5 text-xs text-muted">
            <div class="flex justify-between gap-3">
              <dt>客户端</dt>
              <dd class="text-ink">Java 版</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt>开服时间</dt>
              <dd class="text-ink">2024 年至今</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt>QQ 群</dt>
              <dd class="font-mono text-ink">{site.community.qq}</dd>
            </div>
          </dl>
        </div>
        <a href="/contact" class="mt-4 text-sm text-primary transition-opacity hover:opacity-80">
          加入社区 →
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="BLOG" title="最新文章" />
      <a href="/blog" class="mb-8 text-sm text-primary transition-opacity hover:opacity-80">
        全部文章 →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
    {
      posts.length === 0 && <p class="card p-5 text-sm text-muted">还没有文章，第一篇正在写。</p>
    }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="pixel-grid card relative overflow-hidden p-8 sm:p-10">
      <div class="glow-primary absolute -right-10 -top-10 h-56 w-56" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-xl font-semibold text-strong sm:text-2xl">一起来把这个世界做大</h2>
        <p class="mt-3 text-base leading-relaxed text-muted">
          无论你是想进来盖房子、写代码，还是想一起做 Mod，都欢迎先来社区看看。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="rounded-md border border-primary/40 bg-primary/10 px-5 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-primary/20"
          >
            联系我们
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-primary/50 hover:text-primary"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
