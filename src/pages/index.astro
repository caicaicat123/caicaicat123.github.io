---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServerStatus from '../components/ServerStatus.astro';
import BlogCard from '../components/BlogCard.astro';
import { site } from '../data/site';
import { formatDate } from '../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={site.name}>
  <!-- Hero：两个方向做成可横向滚动的页面 -->
  <HeroCarousel />

  <!-- 服务器状态 -->
  <section id="server-status" class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="SERVER"
        title="服务器状态"
        desc="Java 版 26.1.2，全版本客户端可进，离线模式。"
      />
      <a href="/minecraft" class="mb-14 text-sm text-primary transition-opacity hover:opacity-80">
        服务器详情 →
      </a>
    </div>
    <ServerStatus mini />
  </section>

  <!-- 最新文章 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="BLOG" title="最新文章" />
      <a href="/blog" class="mb-8 text-sm text-primary transition-opacity hover:opacity-80">
        全部文章 →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
    {
      posts.length === 0 && <p class="card p-5 text-sm text-muted">还没有文章，第一篇正在写。</p>
    }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="pixel-grid card relative overflow-hidden p-8 sm:p-10">
      <div class="glow-primary absolute -right-10 -top-10 h-56 w-56" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-xl font-semibold text-strong sm:text-2xl">一起来把这个世界做大</h2>
        <p class="mt-3 text-base leading-relaxed text-muted">
          无论你是想进来盖房子、写代码，还是想一起做 Mod，都欢迎先来社区看看。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="btn btn-accent btn-lg"
          >
            联系我们
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-standard btn-lg"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
