---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HomePortal from '../components/HomePortal.astro';
import PluginGlyph from '../components/PluginGlyph.astro';
import ServerStatus from '../components/ServerStatus.astro';
import { plugins } from '../data/plugins';
import { formatDate } from '../utils/format';
import '../styles/home.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="首页">
  <HomePortal />

  <section class="home-status" id="server-status" aria-labelledby="home-status-title">
    <div class="home-status__inner">
      <div>
        <p class="home-section-kicker">实时运行</p>
        <h2 id="home-status-title">此刻的服务器状态。</h2>
        <p>查看当前服务器状态，详细连接信息在服务器页面。</p>
      </div>
      <a class="home-status__data" href="/minecraft/#server-status" aria-label="查看 Minecraft 服务器实时运行状态">
        <ServerStatus mini />
        <span class="home-status__data-hint">查看运行详情 <span aria-hidden="true">↗</span></span>
      </a>
      <a href="/minecraft/#server-status" class="home-status__link">查看服务器详情 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-work" aria-labelledby="home-work-title">
    <div class="home-work__intro">
      <p class="home-section-kicker">创造工具</p>
      <h2 id="home-work-title">让世界继续运转。</h2>
      <p>我们也开发在服务器上使用的 Minecraft 插件。</p>
    </div>
    <div class="home-work__list">
      {plugins.map((plugin, index) => (
        <a href={plugin.tag === 'NWNDungeon' ? '/plugins/dungeon/' : '/plugins/'} class="home-work__item">
          <span class:list={['home-work__mark', plugin.tag === 'NWNDungeon' ? 'home-work__mark--dungeon' : plugin.tag === 'TheGhost' ? 'home-work__mark--ghost' : 'home-work__mark--other']} aria-hidden="true">
            {plugin.tag === 'NWNDungeon' || plugin.tag === 'TheGhost' ? <PluginGlyph tag={plugin.tag} /> : <span>0{index + 1}</span>}
          </span>
          <span class="home-work__name">{plugin.name}<small>{plugin.tag}</small></span>
          <span class="home-work__description">{plugin.desc}</span>
          <span class="home-work__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <a class="home-work__more" href="/plugins/">查看全部插件与下载信息 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="home-journal" aria-labelledby="home-journal-title">
    <div class="home-journal__intro">
      <div>
        <p class="home-section-kicker">最新记录</p>
        <h2 id="home-journal-title">正在发生。</h2>
      </div>
      <a href="/blog/">浏览全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-journal__list">
      {posts.map((post) => (
        <article class="home-journal__item">
          <div class="home-journal__meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{post.data.category}</span></div>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <span aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  const lines = document.querySelectorAll('.home-work__list, .home-journal__list');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.12 });
    lines.forEach((line) => observer.observe(line));
  } else {
    lines.forEach((line) => line.classList.add('is-visible'));
  }

</script>
