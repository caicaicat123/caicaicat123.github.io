---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServerStatus from '../../components/ServerStatus.astro';
import CopyButton from '../../components/CopyButton.astro';
import { isPlaceholder, site } from '../../data/site';
import { announcements, joinSteps, rules, serverFeatures } from '../../data/minecraft';

const { javaIp, bedrockIp, version } = site.minecraft;
---

<BaseLayout
  title="Minecraft 服务器"
  description="新世界网络 Minecraft 服务器信息：地址、版本、规则、加入教程与实时状态查询。"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="font-pixel mb-3 text-xs tracking-wider text-primary">MINECRAFT</p>
      <h1 class="text-2xl font-semibold text-white sm:text-3xl">服务器信息</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
        这是新世界网络的核心业务载体。世界长期运营，欢迎来盖房子、写红石，或者来当 AI 实验的对照组。
      </p>
    </div>
  </section>

  <!-- 地址与版本 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="CONNECT" title="服务器地址与版本" desc="地址确认后会同步更新到这里。" />
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="card p-5">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-white">Java 版</h2>
          <CopyButton value={javaIp} label="复制地址" />
        </div>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">服务器地址</dt>
            <dd class="font-mono text-ink">{isPlaceholder(javaIp) ? '待填写' : javaIp}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">端口</dt>
            <dd class="font-mono text-ink">
              {isPlaceholder(site.minecraft.port) ? '默认 25565' : site.minecraft.port}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">游戏版本</dt>
            <dd class="font-mono text-ink">{isPlaceholder(version) ? '待填写' : version}</dd>
          </div>
        </dl>
      </div>

      <div class="card p-5">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-white">基岩版</h2>
          <CopyButton value={bedrockIp} label="复制地址" />
        </div>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">服务器地址</dt>
            <dd class="font-mono text-ink">{isPlaceholder(bedrockIp) ? '待填写' : bedrockIp}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">端口</dt>
            <dd class="font-mono text-ink">默认 19132</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">游戏版本</dt>
            <dd class="font-mono text-ink">{isPlaceholder(version) ? '待填写' : version}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <ServerStatus edition="java" />
      <ServerStatus edition="bedrock" />
    </div>
  </section>

  <!-- 特色 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading eyebrow="FEATURES" title="服务器特点" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          serverFeatures.map((feature) => (
            <div class="card p-5">
              <h3 class="text-sm font-semibold text-primary">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{feature.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 加入教程 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="HOW TO JOIN" title="加入教程" desc="四步进服，第一次来照做就行。" />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        joinSteps.map((step, index) => (
          <li class="card p-5">
            <span class="font-pixel text-xs text-primary">
              STEP {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-sm font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 规则 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="RULES"
        title="服务器规则"
        desc="规则不复杂，核心就一句：别破坏别人的体验。"
      />
      <ul class="space-y-3">
        {
          rules.map((rule, index) => (
            <li class="card flex gap-4 p-4">
              <span class="font-pixel text-xs text-muted">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-sm leading-relaxed text-ink">{rule}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 公告 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="NOTICE" title="服务器公告" />
    <div class="space-y-4">
      {
        announcements.map((item) => (
          <article class="card p-5">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
              <span class="badge badge-primary">公告</span>
              <span>{item.date}</span>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
