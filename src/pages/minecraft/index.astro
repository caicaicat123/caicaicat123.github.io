---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServerStatus from '../../components/ServerStatus.astro';
import CopyButton from '../../components/CopyButton.astro';
import Faq from '../../components/Faq.astro';
import { isPlaceholder, site } from '../../data/site';
import { faqs, featureGroups, guideSteps, positioning, ruleGroups, serverSummary } from '../../data/minecraft';

const { javaIp, port, version, clients, mode, openedAt } = site.minecraft;
const address = isPlaceholder(port) ? javaIp : `${javaIp}:${port}`;
const description = `新世界服务器（NewWorldMC，NWM）是新世界网络运营的《我的世界》Java 版插件生存服：地址 ${address}，Purpur ${version}，1.7 至 26.1 全版本可进，离线模式无需正版。含服务器规则、新手指南、玩法特色、插件清单与实时状态。`;

/**
 * 速查表：本页（也是全站）服务器事实的**唯一出处**。
 *
 * 冗余原则（2026-10-04 用户要求「一件事一般情况下只出现一次」）：
 * - 地址、版本、客户端范围、账号验证、开服时间、是否重置、基岩版这些事实，
 *   **只在这张表里完整出现一次**；本页其余章节与 FAQ 不复述，必要时一句话指回本表。
 * - 每个 label 之间也不重复：version 只出现在「服务端版本」一行，
 *   「服务器类型」不再写「Purpur 服务端」（那是同一个事实的第二处）。
 * - 「交流渠道」不写在这里 —— QQ 群的唯一出处是联系页，页脚只放导航入口。
 * 改文案时请守住这三条。
 */
const facts = [
  { label: '服务器类型', value: '《我的世界》Java 版 · 生存服（Purpur 服务端）' },
  { label: '服务器地址', value: address },
  { label: '服务端版本', value: `${version}（Purpur）` },
  { label: '支持的客户端', value: `Java 版 ${clients}` },
  { label: '账号验证', value: mode },
  { label: '开服时间', value: openedAt },
  { label: '世界是否重置', value: '从不重置，建筑与进度长期保留' },
  { label: '在线人数上限', value: '30 人' },
  { label: '基岩版互通', value: '不支持，仅 Java 版客户端可进入' },
];
---

<BaseLayout
  title="新世界服务器"
  description={description}
>
  <!-- 首屏：一句话定位 + 玩法定位，然后是本页唯一的事实表 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="section-label">服务器速查</p>
      <h1 class="text-2xl font-semibold text-strong sm:text-3xl">{site.server.name}</h1>
      <p class="mt-4 max-w-3xl text-base leading-[1.85] text-muted">{serverSummary}</p>
      <!--
        玩法定位句原本独占一个只有 7 行的独立区块，视觉上很空；
        它和 serverSummary 是同一层信息（「这是什么服务器」），所以并到首屏。
      -->
      <p class="mt-3 max-w-3xl text-base leading-[1.85] text-muted">{positioning}</p>

      <div class="card mt-8 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-ink">连接与基本信息</h2>
          <CopyButton value={address} label="复制地址" tone="ghost" />
        </div>
        <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          {
            facts.map((fact) => (
              <div class="flex gap-3 border-b border-line pb-2.5 last:border-0">
                <dt class="w-28 shrink-0 text-muted">{fact.label}</dt>
                <dd class="text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- 怎么加入 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="加入方式"
        title="怎么加入服务器？"
        desc="在 Java 版客户端中添加本页顶部的服务器地址即可接入；首次进入须注册账号，此后每次进入须登录。以下 12 项按建议顺序排列，涵盖从接入到开始参与玩法。"
        descAs="p"
      />
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          guideSteps.map((step, index) => (
            <li class="card p-5">
              <span class="label-latin text-xs text-primary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-sm font-semibold text-strong">{step.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-muted">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 玩法特色 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div>
      <SectionHeading
        eyebrow="玩法特色"
        title="服务器有哪些玩法特色？"
        desc="以下六项是本服务器的完整玩法内容，每一项都写明「玩家实际能做什么」。"
        descAs="p"
      />
      <div class="grid gap-5 lg:grid-cols-2">
        {
          featureGroups.map((group) => (
            <article class="card p-6">
              <h3 class="text-base font-semibold text-strong">{group.title}</h3>
              <p class="mt-3 text-base leading-[1.85] text-ink">{group.summary}</p>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
                {group.points.map((point) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 bg-primary" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 服务器规则 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="服务器规则"
        title="服务器规则有哪些？"
        desc="服务器规则以维护公共游戏环境为目的，按账号、行为、建筑、交易、聊天五组列出如下。进入服务器即视为已知悉并同意本规则。"
        descAs="p"
      />
      <!-- 规则属于连续说明：一条线 + 留白分段，不用卡片（形状要携带信息） -->
      <div class="divide-y divide-line border-y border-line">
        {
          ruleGroups.map((group, groupIndex) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <h3 class="text-base font-semibold text-strong">
                <span class="mr-2 font-mono text-xs text-muted">
                  {String(groupIndex + 1).padStart(2, '0')}
                </span>
                {group.title}
              </h3>
              <ul class="space-y-2.5 text-base leading-[1.85] text-muted">
                {group.items.map((item) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[0.7em] h-1.5 w-1.5 shrink-0 rotate-45 bg-primary" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
        本规则可能随版本与玩法调整，最新版本以游戏内告示与 QQ 群公告为准。如对处理结果有异议，可在 QQ 群内提出申诉。
      </p>
    </div>
  </section>

  <!-- 实时状态与常见问题 -->
  <section id="server-status" class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="运行状态"
      title="服务器现在开着吗？"
      desc="服务器长期开放。以下为实时状态查询；相关数据由浏览器在页面加载后获取，若脚本未执行则可能显示为空，此情况不代表服务器离线。"
      descAs="p"
    />
    <ServerStatus compact />
    <noscript>
      <p class="card mt-4 p-5 text-sm leading-relaxed text-muted">
        当前环境未执行脚本，实时状态无法显示。服务器地址固定为 {address}；如需确认是否在线，可在《我的世界》客户端的服务器列表中查看，
        或在 QQ 群 {site.community.qq} 中咨询。
      </p>
    </noscript>
  </section>

  <Faq
    eyebrow="其他问题"
    title="还有哪些常见问题？"
    desc="以上未覆盖的少数问题：破坏防范、经济规则与故障排查路径。"
    items={faqs}
  />
</BaseLayout>
