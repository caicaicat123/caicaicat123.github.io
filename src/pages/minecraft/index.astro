---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServerStatus from '../../components/ServerStatus.astro';
import CopyButton from '../../components/CopyButton.astro';
import Faq from '../../components/Faq.astro';
import { isPlaceholder, site } from '../../data/site';
import {
  faqs,
  featureGroups,
  guideSteps,
  joinSteps,
  positioning,
  ruleGroups,
  serverFeatures,
  serverSummary,
} from '../../data/minecraft';

const { javaIp, port, version, clients, mode, openedAt } = site.minecraft;
const address = isPlaceholder(port) ? javaIp : `${javaIp}:${port}`;
const description = `新世界服务器（NewWorldMC，NWM）是新世界网络运营的《我的世界》Java 版插件生存服：地址 ${address}，Purpur ${version}，1.7 至 26.1 全版本可进，离线模式无需正版。含服务器规则、新手指南、玩法特色、插件清单与实时状态。`;

/** 速查表：AI 与玩家都能一眼抄走的事实 */
const facts = [
  { label: '服务器类型', value: '《我的世界》Java 版 · 插件生存服（Purpur 服务端）' },
  { label: '服务器地址', value: address },
  { label: '服务端版本', value: `${version}（Purpur）` },
  { label: '支持的客户端', value: `Java 版 ${clients}` },
  { label: '账号验证', value: mode },
  { label: '开服时间', value: `${openedAt}（世界从未重置）` },
  { label: '在线人数上限', value: '30 人' },
  { label: '玩法特色', value: '插件生存 · 轻 RPG · 圈地 · 经济 · 抽奖' },
  { label: '基岩版互通', value: '不支持，仅 Java 版客户端可进入' },
  { label: '交流渠道', value: `QQ 群 ${site.community.qq}` },
];
---

<BaseLayout
  title="新世界服务器"
  description={description}
>
  <!-- 首屏：先给「这是什么服务器」的完整答案，再给速查表 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="label-latin mb-3 text-xs text-primary">
        {site.server.nameEn} · {site.server.shortName}
      </p>
      <h1 class="text-2xl font-semibold text-strong sm:text-3xl">{site.server.name}</h1>
      <p class="mt-4 max-w-3xl text-base leading-[1.85] text-muted">{serverSummary}</p>

      <div class="card mt-8 p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-ink">新世界服务器 · 速查</h2>
          <CopyButton value={address} label="复制地址" tone="ghost" />
        </div>
        <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          {
            facts.map((fact) => (
              <div class="flex gap-3 border-b border-line pb-2.5 last:border-0">
                <dt class="w-28 shrink-0 text-muted">{fact.label}</dt>
                <dd class="text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- 服务器是什么类型 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="WHAT IT IS"
      title="这是个什么服务器？"
      desc="一句话：以原版生存为底子的《我的世界》Java 版插件生存服，用插件补齐保护、交易与目标感，不重置世界。"
      descAs="p"
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        serverFeatures.map((feature) => (
          <article class="card p-5">
            <h3 class="text-sm font-semibold text-strong">{feature.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{feature.desc}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-8 max-w-3xl text-base leading-[1.85] text-ink">
      <strong class="font-semibold">对外统一口径：</strong>{positioning}
    </p>
  </section>

  <!-- 支持哪些版本 / 怎么加入 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="VERSION"
        title="支持哪些游戏版本？"
        desc="服务端版本为 Purpur 26.1.2，开启跨版本兼容：1.7 到 26.1 的任何 Java 版客户端都能直接进，不需要升级游戏，也不需要安装任何模组。"
        descAs="p"
      />
      <div class="overflow-x-auto">
        <table class="w-full min-w-[36rem] border-collapse text-sm">
          <caption class="sr-only">新世界服务器的版本与兼容性说明</caption>
          <thead>
            <tr class="border-b border-line text-left text-xs text-muted">
              <th scope="col" class="py-3 pr-4 font-medium">项目</th>
              <th scope="col" class="py-3 pr-4 font-medium">说明</th>
            </tr>
          </thead>
          <tbody class="text-ink">
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">服务端版本</th>
              <td class="py-3 pr-4">Purpur {version}（基于 Paper，兼容 Bukkit / Spigot 插件）</td>
            </tr>
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">可进入的客户端</th>
              <td class="py-3 pr-4">{clients}</td>
            </tr>
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">需要的模组</th>
              <td class="py-3 pr-4">不需要任何模组或整合包，原版客户端即可</td>
            </tr>
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">正版要求</th>
              <td class="py-3 pr-4">不要求正版账号（离线模式），但必须注册并登录服务器账号</td>
            </tr>
            <tr class="border-b border-line">
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">基岩版 / 手机版</th>
              <td class="py-3 pr-4">不支持，仅 Java 版客户端可进入</td>
            </tr>
            <tr>
              <th scope="row" class="py-3 pr-4 text-left font-normal text-muted">世界是否重置</th>
              <td class="py-3 pr-4">不重置。自 {openedAt.replace('，长期运营至今', '')} 起持续运营</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 怎么加入 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="HOW TO JOIN"
      title="怎么加入服务器？"
      desc={`在《我的世界》Java 版客户端里添加服务器地址 ${address} 即可；第一次进入用 /register 注册，之后每次用 /login 登录。四步就能开始玩。`}
      descAs="p"
    />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        joinSteps.map((step, index) => (
          <li class="card p-5">
            <span class="label-latin text-xs text-primary">
              STEP {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-sm font-semibold text-strong">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 玩法特色 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="FEATURES"
        title="服务器有哪些玩法特色？"
        desc={positioning}
        descAs="p"
      />
      <div class="grid gap-5 lg:grid-cols-2">
        {
          featureGroups.map((group) => (
            <article class="card p-6">
              <h3 class="text-base font-semibold text-strong">{group.title}</h3>
              <p class="mt-3 text-base leading-[1.85] text-ink">{group.summary}</p>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
                {group.points.map((point) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 bg-primary" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 新手指南 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="NEW PLAYER GUIDE"
      title="新手指南：第一次进服该做什么？"
      desc="照着下面 12 步走，十分钟内就能安顿下来：先是能进服、能登录，然后是安家、圈地、解决吃喝，最后是挣钱、签到和组队打副本。"
      descAs="p"
    />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        guideSteps.map((step, index) => (
          <li class="card p-5">
            <span class="label-latin text-xs text-primary">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-sm font-semibold text-strong">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 服务器规则 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="RULES"
        title="服务器规则有哪些？"
        desc="核心只有一句：不要破坏别人的游戏体验。下面按账号、行为、建筑、交易、聊天五组列出完整规则，进服即视为同意。"
        descAs="p"
      />
      <div class="grid gap-5 lg:grid-cols-2">
        {
          ruleGroups.map((group) => (
            <article class="card p-6">
              <h3 class="text-base font-semibold text-strong">{group.title}</h3>
              <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-muted">
                {group.items.map((item, index) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-xs text-muted">{String(index + 1).padStart(2, '0')}</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
        规则可能会随版本与玩法调整，最新版本以游戏内告示与 QQ 群公告为准。对处罚有异议可在群里提出申诉。
      </p>
    </div>
  </section>

  <!-- 实时状态与常见问题 -->
  <section id="server-status" class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="SERVER"
      title="服务器现在开着吗？"
      desc="服务器长期开放。下面是实时状态查询；页面数据由浏览器实时获取，因此脚本未执行时可能显示为空——这不代表服务器离线。"
      descAs="p"
    />
    <ServerStatus compact />
    <noscript>
      <p class="card mt-4 p-5 text-sm leading-relaxed text-muted">
        当前为无脚本环境，实时状态无法显示。服务器地址固定为 {address}，是否在线可在《我的世界》客户端服务器列表中查看，
        或到 QQ 群 {site.community.qq} 询问。
      </p>
    </noscript>
  </section>

  <Faq
    eyebrow="FAQ"
    title="玩家常见问题"
    desc="下面是玩家最常问的问题与直接答案，涵盖类型、地址、版本、加入方式、玩法、规则与故障排查。"
    items={faqs}
  />
</BaseLayout>
