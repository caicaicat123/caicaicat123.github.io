---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServerStatus from '../../components/ServerStatus.astro';
import CopyButton from '../../components/CopyButton.astro';
import { isPlaceholder, site } from '../../data/site';
import { announcements, joinSteps, rules, serverFeatures } from '../../data/minecraft';

const { javaIp, port, version, mode, openedAt } = site.minecraft;
const address = isPlaceholder(port) ? javaIp : `${javaIp}:${port}`;
---

<BaseLayout
  title="Minecraft 服务器"
  description="新世界网络 Minecraft Java 版插件生存服：地址、版本、规则、加入教程与实时状态查询。"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="font-pixel mb-3 text-xs tracking-wider text-primary">MINECRAFT</p>
      <h1 class="text-2xl font-semibold text-white sm:text-3xl">Java 版插件生存服</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
        一台持续运营的《我的世界》生存服务器，{openedAt}。在原版生存基础上加入实用插件，
        同时也是我们做 AI 实验的真实场地。
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="badge badge-primary font-mono">{address}</span>
        <span class="badge">Java {version}</span>
        <span class="badge">{mode}</span>
        <CopyButton value={address} label="复制地址" tone="ghost" />
      </div>
    </div>
  </section>

  <!-- 连接信息 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="CONNECT"
      title="连接信息"
      desc="离线模式可进，进服后用登录插件注册账号即可。"
    />
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="card p-5">
        <dl class="space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">服务器地址</dt>
            <dd class="font-mono text-ink">{javaIp}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">端口</dt>
            <dd class="font-mono text-ink">{port}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">游戏版本</dt>
            <dd class="font-mono text-ink">{version}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">客户端</dt>
            <dd class="text-ink">Java 版（无基岩版）</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">账号验证</dt>
            <dd class="text-ink">{mode}</dd>
          </div>
        </dl>
      </div>

      <ServerStatus />
    </div>
  </section>

  <!-- 特色 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading eyebrow="FEATURES" title="服务器特点" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          serverFeatures.map((feature) => (
            <div class="card p-5">
              <h3 class="text-sm font-semibold text-primary">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{feature.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 加入教程 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="HOW TO JOIN" title="加入教程" desc="四步进服，第一次来照做就行。" />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        joinSteps.map((step, index) => (
          <li class="card p-5">
            <span class="font-pixel text-xs text-primary">
              STEP {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-sm font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 规则 -->
  <section class="border-y border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="RULES"
        title="服务器规则"
        desc="规则不复杂，核心就一句：别破坏别人的体验。"
      />
      <ul class="space-y-3">
        {
          rules.map((rule, index) => (
            <li class="card flex gap-4 p-4">
              <span class="font-pixel text-xs text-muted">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-sm leading-relaxed text-ink">{rule}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 公告 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="NOTICE" title="服务器公告" />
    <div class="space-y-4">
      {
        announcements.map((item) => (
          <article class="card p-5">
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
              <span class="badge badge-primary">公告</span>
              <span>{item.date}</span>
            </div>
            <h3 class="mt-3 text-sm font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>

    <div class="card mt-6 flex flex-wrap items-center gap-4 p-5">
      <div>
        <p class="text-sm font-medium text-ink">想加入社区？</p>
        <p class="mt-1 text-sm text-muted">
          QQ 群 <span class="font-mono text-ink">{site.community.qq}</span>，公告与找人组队都在群里。
        </p>
      </div>
      <CopyButton value={site.community.qq} label="复制群号" tone="ghost" />
    </div>
  </section>
</BaseLayout>
