---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServerStatus from '../../components/ServerStatus.astro';
import CopyButton from '../../components/CopyButton.astro';
import { isPlaceholder, site } from '../../data/site';
import { joinSteps, rules } from '../../data/minecraft';

const { javaIp, port, version, clients, mode, openedAt } = site.minecraft;
const address = isPlaceholder(port) ? javaIp : `${javaIp}:${port}`;
---

<BaseLayout
  title="新世界服务器"
  description="新世界服务器（NewWorldMC，NWM）：新世界网络运营的《我的世界》Java 版插件生存服，含地址、版本、规则、加入教程与实时状态查询。"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <p class="label-latin mb-3 text-xs text-primary">
        {site.server.nameEn} · {site.server.shortName}
      </p>
      <h1 class="text-2xl font-medium text-strong sm:text-3xl">{site.server.name}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
        一台持续运营的《我的世界》Java 版插件生存服，{openedAt}。当前版本 {version}，
        1.7 到 26.1 的任何客户端都能直接进入，离线模式也能玩。原版生存基础上加了实用插件，
        还有一只住在聊天里的「幽灵」。
      </p>
    </div>
  </section>

  <!-- 连接信息 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      eyebrow="CONNECT"
      title="连接信息"
      desc="离线模式可进，进服后用登录插件注册账号即可。"
    />
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="card p-5">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base font-medium text-ink">连接方式</h2>
          <CopyButton value={address} label="复制地址" tone="ghost" />
        </div>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">服务器地址</dt>
            <dd class="font-mono text-ink">{address}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">游戏版本</dt>
            <dd class="font-mono text-ink">{version}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">客户端</dt>
            <dd class="text-ink">Java 版 · {clients}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-muted">账号验证</dt>
            <dd class="text-ink">{mode}</dd>
          </div>
        </dl>
      </div>

      <ServerStatus compact />
    </div>
  </section>

  <!-- 加入教程 -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading eyebrow="HOW TO JOIN" title="加入教程" desc="四步进服，第一次来照做就行。" />
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        joinSteps.map((step, index) => (
          <li class="card p-5">
            <span class="label-latin text-xs text-primary">
              STEP {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-base font-medium text-strong">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 规则 -->
  <section class="band border-y border-line">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        eyebrow="RULES"
        title="服务器规则"
        desc="规则不复杂，核心就一句：别破坏别人的体验。"
      />
      <ul class="space-y-3">
        {
          rules.map((rule, index) => (
            <li class="card flex gap-4 p-4">
              <span class="font-mono text-xs text-muted">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="text-base leading-relaxed text-ink">{rule}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

</BaseLayout>
