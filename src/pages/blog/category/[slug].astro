---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { blogCategories } from '../../../data/blog';
import { formatDate } from '../../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // 只为一篇都没有的分类建页：空壳分类页会被 sitemap 收录，
  // 属于典型的薄内容页（改动前 /blog/category/notes/ 就是空的，线上 200）。
  return blogCategories
    .filter((category) => posts.some((post) => post.data.category === category.name))
    .map((category) => ({
      params: { slug: category.slug },
      props: { category },
    }));
}

const { category } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category.name)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 只列有文章的分类 —— 否则会链到根本没生成的分类页（404）
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const existingCategories = blogCategories.filter((item) =>
  allPosts.some((post) => post.data.category === item.name),
);
---

<BaseLayout
  title={`${category.name} · 博客`}
  description={`新世界网络博客分类：${category.name}。${category.desc}`}
>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <a href="/blog/" class="text-sm text-muted transition-colors hover:text-primary">← 全部文章</a>

    <div class="mt-6">
      <SectionHeading eyebrow="CATEGORY" title={category.name} desc={category.desc} />
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      {
        existingCategories.map((item) => (
          <a
            href={`/blog/category/${item.slug}/`}
            class:list={['badge', item.slug === category.slug ? 'badge-primary' : '']}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
