---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { blogCategories } from '../../../data/blog';
import { formatDate } from '../../../utils/format';

export async function getStaticPaths() {
  return blogCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category.name)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${category.name} · 博客`}
  description={`新世界网络博客分类：${category.name}。${category.desc}`}
>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <a href="/blog" class="text-sm text-muted transition-colors hover:text-primary">← 全部文章</a>

    <div class="mt-6">
      <SectionHeading eyebrow="CATEGORY" title={category.name} desc={category.desc} />
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      {
        blogCategories.map((item) => (
          <a
            href={`/blog/category/${item.slug}/`}
            class:list={[
              'badge',
              item.slug === category.slug ? 'badge-primary' : '',
            ]}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="card p-6 text-sm text-muted">
          这个分类还没有文章。想投稿或者建议选题，欢迎在
          <a href="/contact" class="text-primary hover:opacity-80">联系页</a>
          找到我们。
        </p>
      )
    }
  </section>
</BaseLayout>
