---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { blogCategories } from '../../data/blog';
import { formatDate } from '../../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = blogCategories.map((category) => ({
  ...category,
  count: posts.filter((post) => post.data.category === category.name).length,
}));
---

<BaseLayout
  title="博客"
  description="新世界网络的博客：服务器动态、开发记录，以及技术之外的随笔与思考。"
>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <SectionHeading
      as="h1"
      eyebrow="BLOG"
      title="博客"
      desc={`写技术，也写技术之外的东西。目前共 ${posts.length} 篇。`}
    />

    <div class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((category) => (
          <a
            href={`/blog/category/${category.slug}/`}
            class="card flex flex-col p-4 transition-colors"
          >
            <span class="flex items-center gap-2 text-sm font-medium text-ink">
              {category.name}
              <span class="badge">{category.count}</span>
            </span>
            <span class="mt-1.5 text-xs leading-relaxed text-muted">{category.desc}</span>
          </a>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-2 border-t border-line pt-6">
      <a href="/rss.xml" class="badge badge-primary">RSS 订阅</a>
      <span class="text-xs text-muted">文章按发布时间倒序排列</span>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}/`}
            date={formatDate(post.data.pubDate)}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="card p-6 text-sm text-muted">还没有文章，第一篇正在写。</p>
      )
    }
  </section>
</BaseLayout>
